<diagram name="F2-1 Lập kế hoạch" id="p1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="3182" pageHeight="1140" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_c1" value="F2 · TRANG 1/4 — Lập kế hoạch bảo trì định kỳ (Officer phụ trách tòa, theo LOẠI THIẾT BỊ)" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="3142" height="30" as="geometry"/></mxCell><mxCell id="p1_c2" value="Kế hoạch bảo trì NĂM được duyệt NGOÀI hệ thống (chung cư: Hội nghị nhà chung cư thông qua — Điều 33 TT 05/2024/TT-BXD; văn phòng: chủ đầu tư / ban quản lý). Trong hệ thống, Officer biến kế hoạch đó thành lịch chạy cho từng thiết bị (PM-02). Một kế hoạch áp cho nhiều thiết bị cùng loại (ERD: PreventivePlan M—M Asset).&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · xám viền đứt = việc NGOÀI hệ thống · ①–⑬ = đường chính · ⏱ = thời gian · ↩ = quay lại · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy · thẻ AI = điểm AI hỗ trợ." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="3142" height="48" as="geometry"/></mxCell><mxCell id="p1_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="3162" height="170" as="geometry"/></mxCell><mxCell id="p1_c4" value="Admin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="170" as="geometry"/></mxCell><mxCell id="p1_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="270" width="3162" height="560" as="geometry"/></mxCell><mxCell id="p1_c6" value="Officer&lt;br&gt;phụ trách tòa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="270" width="130" height="560" as="geometry"/></mxCell><mxCell id="p1_c7" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="830" width="3162" height="280" as="geometry"/></mxCell><mxCell id="p1_c8" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="830" width="130" height="280" as="geometry"/></mxCell><mxCell id="p1_n_tpl" value="Admin tạo MẪU checklist theo LOẠI THIẾT BỊ ở F1 (G6): các mục kiểm tra, chu kỳ gợi ý, thời gian chuẩn, quy chuẩn tham chiếu." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="298" y="149" width="330" height="72" as="geometry"/></mxCell><mxCell id="p1_s1" value="BẮT ĐẦU — Officer lập&lt;br&gt;kế hoạch cho thiết bị&lt;br&gt;của tòa mình phụ trách" style="whiteSpace=wrap;html=1;fillColor=#1d2b4f;strokeColor=#1d2b4f;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;ellipse;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="158" y="458" width="180" height="74" as="geometry"/></mxCell><mxCell id="p1_o_type" value="Chọn TÒA (chỉ tòa mình)&lt;br&gt;+ LOẠI THIẾT BỊ&lt;br&gt;(danh mục F1)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="374" y="459" width="176" height="72" as="geometry"/></mxCell><mxCell id="p1_dTpl" value="Loại thiết bị&lt;br&gt;có MẪU&lt;br&gt;checklist?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="602" y="447" width="150" height="96" as="geometry"/></mxCell><mxCell id="p1_o_manual" value="Officer nhập checklist&lt;br&gt;thủ công (R3 PM-02&lt;br&gt;hiện làm như vậy)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="592" y="320" width="170" height="70" as="geometry"/></mxCell><mxCell id="p1_op_tpl" value="OPEN P01: bắt buộc mọi loại thiết bị phải có MẪU (G6) hay cho nhập tay? Đề xuất: bắt buộc với thiết bị bắt buộc kiểm định, còn lại cho nhập tay." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="354" y="309" width="196" height="92" as="geometry"/></mxCell><mxCell id="p1_ai_cyc" value="AI · gợi ý chu kỳ + mục checklist&lt;br&gt;theo loại thiết bị, tuổi, lịch sử&lt;br&gt;hỏng (F3) và quy chuẩn tham&lt;br&gt;chiếu; Officer quyết định" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=14;dashed=1;dashPattern=4 3;fillColor=#E8F0FE;strokeColor=#1A56DB;" vertex="1" parent="1"><mxGeometry x="802" y="585" width="200" height="80" as="geometry"/></mxCell><mxCell id="p1_o_cycle" value="Đặt CHU KỲ (ngày / tuần /&lt;br&gt;tháng / năm) + KIỂU LỊCH:&lt;br&gt;CỐ ĐỊNH hay TRƯỢT" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="812" y="459" width="180" height="72" as="geometry"/></mxCell><mxCell id="p1_op_sched" value="OPEN P02: CỐ ĐỊNH (tính từ ngày đến hạn — kiểm định, PCCC) hay TRƯỢT (tính từ ngày làm xong — vệ sinh điều hòa)? Đề xuất: Officer chọn; thiết bị bắt buộc kiểm định chỉ được CỐ ĐỊNH." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1032" y="303" width="210" height="104" as="geometry"/></mxCell><mxCell id="p1_dMand" value="Thiết bị BẮT&lt;br&gt;BUỘC kiểm định /&lt;br&gt;có quy chuẩn?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1056" y="445" width="164" height="100" as="geometry"/></mxCell><mxCell id="p1_s_limit" value="CHẶN chu kỳ dài hơn quy&lt;br&gt;chuẩn; bắt buộc người làm&lt;br&gt;có chứng chỉ (bên thứ 3 /&lt;br&gt;đơn vị kiểm định)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1042" y="883" width="190" height="84" as="geometry"/></mxCell><mxCell id="p1_o_assets" value="Chọn THIẾT BỊ áp dụng&lt;br&gt;(nhiều thiết bị / kế hoạch);&lt;br&gt;bỏ thiết bị Retired; đánh&lt;br&gt;dấu thiết bị ở KHU THUÊ" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1278" y="453" width="190" height="84" as="geometry"/></mxCell><mxCell id="p1_dPerf" value="Ai thực&lt;br&gt;hiện?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1532" y="452" width="130" height="86" as="geometry"/></mxCell><mxCell id="p1_o_tech" value="Technician nội bộ mặc&lt;br&gt;định (khớp chuyên môn);&lt;br&gt;để trống = Officer giao&lt;br&gt;mỗi kỳ" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1508" y="315" width="180" height="80" as="geometry"/></mxCell><mxCell id="p1_o_vend" value="Bên thứ 3 có HỢP ĐỒNG&lt;br&gt;(thang máy, PCCC, kiểm&lt;br&gt;định): chọn từ danh bạ&lt;br&gt;(F5) + Technician đầu mối" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1504" y="583" width="186" height="84" as="geometry"/></mxCell><mxCell id="p1_o_time" value="Ngày bắt đầu, LEAD TIME&lt;br&gt;(mặc định 3 ngày, BR-06),&lt;br&gt;CỬA SỔ ĐÚNG HẠN ± 10%&lt;br&gt;chu kỳ, thời gian chuẩn" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1728" y="453" width="190" height="84" as="geometry"/></mxCell><mxCell id="p1_s_prev" value="Xem trước 5 kỳ tới; dời kỳ&lt;br&gt;rơi vào NGÀY NGHỈ của tòa&lt;br&gt;sang ngày làm việc kế&lt;br&gt;(O04); cảnh báo TRÙNG kế&lt;br&gt;hoạch khác cùng thiết bị" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1722" y="877" width="200" height="96" as="geometry"/></mxCell><mxCell id="p1_dOK" value="Officer&lt;br&gt;kích hoạt?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1988" y="451" width="140" height="88" as="geometry"/></mxCell><mxCell id="p1_st_active" value="KH Đang chạy" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2202" y="475" width="140" height="40" as="geometry"/></mxCell><mxCell id="p1_c_p2" value="⇢ Trang 2&lt;br&gt;khi đến kỳ" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2412" y="467" width="130" height="56" as="geometry"/></mxCell><mxCell id="p1_s_pause" value="BẮT ĐẦU (cách 3) — Officer&lt;br&gt;tạm dừng / kết thúc kế&lt;br&gt;hoạch, ghi lý do" style="whiteSpace=wrap;html=1;fillColor=#1d2b4f;strokeColor=#1d2b4f;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;ellipse;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2122" y="713" width="200" height="74" as="geometry"/></mxCell><mxCell id="p1_dPause" value="Tạm dừng hay&lt;br&gt;kết thúc?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="2382" y="706" width="150" height="88" as="geometry"/></mxCell><mxCell id="p1_st_end" value="KH Kết thúc" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2392" y="605" width="130" height="40" as="geometry"/></mxCell><mxCell id="p1_st_pause" value="KH Tạm dừng" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2608" y="730" width="130" height="40" as="geometry"/></mxCell><mxCell id="p1_o_resume" value="Tiếp tục: kỳ kế tính&lt;br&gt;lại từ ngày tiếp tục" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2792" y="720" width="170" height="60" as="geometry"/></mxCell><mxCell id="p1_st_act2" value="KH Đang chạy" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3012" y="730" width="140" height="40" as="geometry"/></mxCell><mxCell id="p1_s_sys" value="BẮT ĐẦU (cách 2) — thiết&lt;br&gt;bị BẮT BUỘC kiểm định&lt;br&gt;chưa có kế hoạch → nhắc&lt;br&gt;Officer (F1, A05)" style="whiteSpace=wrap;html=1;fillColor=#1d2b4f;strokeColor=#1d2b4f;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;ellipse;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="152" y="883" width="190" height="84" as="geometry"/></mxCell><mxCell id="p1_s_fill" value="Điền sẵn checklist, chu kỳ&lt;br&gt;gợi ý, thời gian chuẩn từ&lt;br&gt;MẪU (SAO CHÉP: sửa mẫu&lt;br&gt;sau không đổi kế hoạch cũ)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="580" y="883" width="196" height="84" as="geometry"/></mxCell><mxCell id="p1_note_reg" value="Tham chiếu chu kỳ (nguồn ở tài liệu F2): THANG MÁY — kiểm định ≤ 3 năm / lần, ≤ 2 năm nếu đã dùng &amp;gt; 10 năm, do tổ chức kiểm định được cấp phép; bảo trì do đơn vị có năng lực (hợp đồng). PCCC — kiểm tra, bảo dưỡng ít nhất 1 lần / năm, bình chữa cháy 6 tháng. MÁY PHÁT — chạy thử hằng tháng ≥ 30 phút (NFPA 110, tham chiếu quốc tế)." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1062" y="997" width="600" height="86" as="geometry"/></mxCell><mxCell id="p1_op_reg" value="OPEN P03: danh sách thiết bị bắt buộc + chu kỳ tối đa — ai nhập, theo văn bản hiện hành nào (luật PCCC đổi 2024–2025)? Đề xuất: Admin nhập ở mẫu F1, ghi số hiệu văn bản." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1962" y="992" width="230" height="96" as="geometry"/></mxCell><mxCell id="p1_note_end" value="Kế hoạch tự KẾT THÚC khi thiết bị cuối cùng bị thanh lý (F1 Trang 4). Tạm dừng: kỳ đang chờ không sinh lệnh. Kết thúc: lệnh đã sinh vẫn làm tiếp." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2488" y="1000" width="330" height="80" as="geometry"/></mxCell><mxCell id="p1_c9" value="G6" style="rounded=1;arcSize=40;html=1;fillColor=#EDE4FA;strokeColor=#7B4FC9;fontColor=#4B2A8A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="600" y="138" width="26" height="18" as="geometry"/></mxCell><mxCell id="p1_c10" value="N11" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="304" y="447" width="31" height="18" as="geometry"/></mxCell><mxCell id="p1_c11" value="①" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="362" y="447" width="26" height="26" as="geometry"/></mxCell><mxCell id="p1_c12" value="G3" style="rounded=1;arcSize=40;html=1;fillColor=#EDE4FA;strokeColor=#7B4FC9;fontColor=#4B2A8A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="522" y="448" width="26" height="18" as="geometry"/></mxCell><mxCell id="p1_c13" value="G6" style="rounded=1;arcSize=40;html=1;fillColor=#EDE4FA;strokeColor=#7B4FC9;fontColor=#4B2A8A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="724" y="436" width="26" height="18" as="geometry"/></mxCell><mxCell id="p1_c14" value="G6" style="rounded=1;arcSize=40;html=1;fillColor=#EDE4FA;strokeColor=#7B4FC9;fontColor=#4B2A8A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="522" y="298" width="26" height="18" as="geometry"/></mxCell><mxCell id="p1_c15" value="N20" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F7