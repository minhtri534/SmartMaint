<diagram name="F2-3 Thực hiện &amp; ghi nhận" id="p3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="3327" pageHeight="1210" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3_c1" value="F2 · TRANG 3/4 — Thực hiện checklist, xử lý mục không đạt, nghiệm thu, ghi PHIẾU KIỂM TRA và tính kỳ sau" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="3287" height="30" as="geometry"/></mxCell><mxCell id="p3_c2" value="Mục &quot;Không đạt&quot; được xử lý ngay nếu nhỏ, hoặc sinh case sửa chữa (BR-07) → F3, nguy hiểm → F4. Lịch sử thiết bị (G5) và tỷ lệ đúng lịch (G7) lấy từ phiếu kiểm tra. Manager chỉ xem (BR-12) ở F6.&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · xám viền đứt = việc NGOÀI hệ thống · ①–⑬ = đường chính · ⏱ = thời gian · ↩ = quay lại · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy · thẻ AI = điểm AI hỗ trợ." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="3287" height="48" as="geometry"/></mxCell><mxCell id="p3_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="3307" height="160" as="geometry"/></mxCell><mxCell id="p3_c4" value="Bên thứ 3 có&lt;br&gt;hợp đồng / đơn vị&lt;br&gt;kiểm định&lt;br&gt;(ngoài hệ thống)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="160" as="geometry"/></mxCell><mxCell id="p3_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="260" width="3307" height="420" as="geometry"/></mxCell><mxCell id="p3_c6" value="Technician" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="260" width="130" height="420" as="geometry"/></mxCell><mxCell id="p3_c7" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="680" width="3307" height="260" as="geometry"/></mxCell><mxCell id="p3_c8" value="Officer&lt;br&gt;phụ trách tòa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="680" width="130" height="260" as="geometry"/></mxCell><mxCell id="p3_c9" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="940" width="3307" height="240" as="geometry"/></mxCell><mxCell id="p3_c10" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="940" width="130" height="240" as="geometry"/></mxCell><mxCell id="p3_c_in3" value="⇢ từ Trang 2&lt;br&gt;(Assigned)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="325" width="136" height="60" as="geometry"/></mxCell><mxCell id="p3_dAcc" value="Nhận&lt;br&gt;việc?" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="402" y="313" width="120" height="84" as="geometry"/></mxCell><mxCell id="p3_st_acc" value="Accepted" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="612" y="335" width="132" height="40" as="geometry"/></mxCell><mxCell id="p3_t_start" value="Bắt đầu tại&lt;br&gt;hiện trường" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="822" y="327" width="140" height="56" as="geometry"/></mxCell><mxCell id="p3_st_inp" value="In Progress" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1042" y="335" width="132" height="40" as="geometry"/></mxCell><mxCell id="p3_t_late" value="⏱ Đến hạn mà lệnh chưa&lt;br&gt;Completed (dù đang ở trạng thái&lt;br&gt;nào) → nhắc Technician +&lt;br&gt;Officer; kỳ tính TRỄ ở F6" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1002" y="445" width="210" height="80" as="geometry"/></mxCell><mxCell id="p3_dVend" value="Bên thứ 3&lt;br&gt;làm theo&lt;br&gt;hợp đồng?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1252" y="307" width="140" height="96" as="geometry"/></mxCell><mxCell id="p3_x_vend" value="Bên thứ 3 bảo trì / kiểm&lt;br&gt;định; Technician đầu mối&lt;br&gt;có mặt, nhận BIÊN BẢN /&lt;br&gt;TEM kiểm định" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;dashed=1;dashPattern=8 4;fillColor=#F4F4F5;strokeColor=#71717A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1342" y="139" width="210" height="82" as="geometry"/></mxCell><mxCell id="p3_t_check" value="Làm CHECKLIST từng mục:&lt;br&gt;Đạt / Không đạt / N/A; Không&lt;br&gt;đạt bắt buộc ghi chú + ảnh&lt;br&gt;(TEC-05). Bên thứ 3 làm: điền&lt;br&gt;theo biên bản, đính kèm biên&lt;br&gt;bản + hạn kiểm định kế tiếp" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1472" y="300" width="210" height="110" as="geometry"/></mxCell><mxCell id="p3_ai_fail" value="AI · với mục Không đạt: gợi ý&lt;br&gt;nguyên nhân có thể + hướng&lt;br&gt;xử lý từ lịch sử thiết bị&lt;br&gt;(định vị sự cố); Technician&lt;br&gt;quyết định" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=14;dashed=1;dashPattern=4 3;fillColor=#E8F0FE;strokeColor=#1A56DB;" vertex="1" parent="1"><mxGeometry x="1472" y="440" width="210" height="90" as="geometry"/></mxCell><mxCell id="p3_dFail" value="Có mục&lt;br&gt;Không đạt?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1752" y="311" width="140" height="88" as="geometry"/></mxCell><mxCell id="p3_dHow" value="Xử lý mục&lt;br&gt;Không đạt?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1752" y="441" width="140" height="88" as="geometry"/></mxCell><mxCell id="p3_t_fixnow" value="Sửa ngay + GHI NHẬN&lt;br&gt;SỬA CHỮA trong lệnh&lt;br&gt;(N21): nội dung, linh kiện&lt;br&gt;ghi tay, ảnh trước / sau" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1974" y="443" width="186" height="84" as="geometry"/></mxCell><mxCell id="p3_t_raise" value="Tick TẠO CASE SỬA CHỮA&lt;br&gt;(BR-07) + chọn mức:&lt;br&gt;thường / NGUY HIỂM" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1728" y="580" width="190" height="70" as="geometry"/></mxCell><mxCell id="p3_t_comp" value="Báo hoàn thành (DLG-11):&lt;br&gt;giờ công; hệ thống so&lt;br&gt;thời gian thực tế với&lt;br&gt;thời gian chuẩn (G7)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2208" y="313" width="190" height="84" as="geometry"/></mxCell><mxCell id="p3_st_comp" value="Completed" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2462" y="335" width="132" height="40" as="geometry"/></mxCell><mxCell id="p3_st_back" value="Approved" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="396" y="465" width="132" height="40" as="geometry"/></mxCell><mxCell id="p3_o_reassign" value="Officer giao người&lt;br&gt;khác (DLG-05)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="382" y="740" width="160" height="60" as="geometry"/></mxCell><mxCell id="p3_st_asg3" value="Assigned" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="182" y="750" width="132" height="40" as="geometry"/></mxCell><mxCell id="p3_o_verify" value="Officer xem checklist,&lt;br&gt;ảnh, biên bản" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2440" y="740" width="176" height="60" as="geometry"/></mxCell><mxCell id="p3_dVer" value="Đạt?" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="2688" y="732" width="110" height="76" as="geometry"/></mxCell><mxCell id="p3_st_closed" value="Closed" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2912" y="750" width="132" height="40" as="geometry"/></mxCell><mxCell id="p3_st_reop" value="Reopened" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2676" y="855" width="132" height="40" as="geometry"/></mxCell><mxCell id="p3_op_verify" value="OPEN P08: Officer xác nhận MỌI lệnh định kỳ hay chỉ lệnh có mục Không đạt / bên thứ 3? Đề xuất: mọi lệnh (giữ quy tắc hiện có), cho xác nhận hàng loạt." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1942" y="722" width="230" height="96" as="geometry"/></mxCell><mxCell id="p3_op_rate" value="OPEN P09: lệnh định kỳ có đánh giá của khách không? Đề xuất: không (như O01 của F3)." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="3062" y="835" width="200" height="80" as="geometry"/></mxCell><mxCell id="p3_op_vend" value="OPEN P07: bên thứ 3 làm hằng tháng (thang máy) có cần MỖI LẦN một lệnh trong hệ thống? Đề xuất: có, để đo đúng lịch và lưu biên bản (G5)." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1738" y="132" width="250" height="96" as="geometry"/></mxCell><mxCell id="p3_dLvl" value="Mức?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1768" y="997" width="110" height="76" as="geometry"/></mxCell><mxCell id="p3_l_F3" value="→ F3: case mới ở&lt;br&gt;Approved, Officer giao" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1978" y="1007" width="180" height="56" as="geometry"/></mxCell><mxCell id="p3_l_F4" value="→ F4: case khẩn cấp;&lt;br&gt;thiết bị Out of service" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1732" y="1102" width="180" height="56" as="geometry"/></mxCell><mxCell id="p3_op_lvl" value="OPEN P06: mục Không đạt NGUY HIỂM (vd. phanh thang máy) → hệ thống tự chuyển thiết bị Out of service hay Officer chuyển?" style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1218" y="1087" width="230" height="86" as="geometry"/></mxCell><mxCell id="p3_s_rec" value="Tạo PHIẾU KIỂM TRA (PM-05/06),&lt;br&gt;ghi LỊCH SỬ thiết bị (G5); tính&lt;br&gt;KỲ SAU: cố định = ngày đến hạn&lt;br&gt;+ chu kỳ, trượt = ngày xong +&lt;br&gt;chu kỳ; đánh dấu ĐÚNG HẠN /&lt;br&gt;TRỄ theo cửa sổ ± 10%" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2862" y="980" width="230" height="110" as="geometry"/></mxCell><mxCell id="p3_l_F6" value="→ F6: tỷ lệ bảo trì&lt;br&gt;đúng lịch (Manager&lt;br&gt;chỉ xem)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3128" y="1003" width="170" height="64" as="geometry"/></mxCell><mxCell id="p3_note_mgr" value="Tỷ lệ đúng lịch = số kỳ làm xong trong cửa sổ ± 10% chu kỳ / số kỳ đến hạn trong kỳ báo cáo (kỳ BỎ vẫn ở mẫu số, kỳ DỜI ghi riêng số lần) — định nghĩa chốt ở S03 (F6)." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="282" y="998" width="480" height="74" as="geometry"/></mxCell><mxCell id="p3_c11" value="⑨" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="412" y="314" width="26" height="26" as="geometry"/></mxCell><mxCell id="p3_c12" value="G7" style="rounded=1;arcSize=40;html=1;fillColor=#EDE4FA;strokeColor=#7B4FC9;fontColor=#4B2A8A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1184" y="434" width="26" height="18" as="geometry"/></mxCell><mxCell id="p3_c13" value="⑩" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1460" y="288" width="26" height="26" as="geometry"/></mxCell><mxCell id="p3_c14" value="G7" style="rounded=1;arcSize=40;html=1;fillColor=#EDE4FA;strokeColor=#7B4FC9;fontColor=#4B2A8A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1654" y="289" width="26" height="18" as="geometry"/></mxCell><mxCell id="p3_c15" value="N20" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor