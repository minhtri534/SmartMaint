se" target="p1_o_resume"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_c56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_o_resume" target="p1_st_act2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;dashed=1;dashPattern=5 4;endArrow=none;strokeColor=#8A94A6;strokeWidth=1.4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_n_tpl" target="p1_dTpl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="185"/><mxPoint x="780" y="495"/></Array></mxGeometry></mxCell><mxCell id="p1_c58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;dashed=1;dashPattern=5 4;endArrow=none;strokeColor=#8A94A6;strokeWidth=1.4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_op_tpl" target="p1_o_manual"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_c59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;dashed=1;dashPattern=5 4;endArrow=none;strokeColor=#8A94A6;strokeWidth=1.4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_ai_cyc" target="p1_o_cycle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_c60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;dashed=1;dashPattern=5 4;endArrow=none;strokeColor=#8A94A6;strokeWidth=1.4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_op_sched" target="p1_o_cycle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_c61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;dashed=1;dashPattern=5 4;endArrow=none;strokeColor=#8A94A6;strokeWidth=1.4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_note_reg" target="p1_s_limit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_c62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;dashed=1;dashPattern=5 4;endArrow=none;strokeColor=#8A94A6;strokeWidth=1.4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_op_reg" target="p1_note_reg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_c63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;dashed=1;dashPattern=5 4;endArrow=none;strokeColor=#8A94A6;strokeWidth=1.4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_note_end" target="p1_st_end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram name="F2-2 Đến kỳ &amp; sinh lệnh" id="p2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2452" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_c1" value="F2 · TRANG 2/4 — Đến kỳ: kiểm tra thiết bị, tránh &quot;vừa sửa hôm qua, hôm nay lại kiểm tra&quot; (G3), sinh lệnh bảo trì" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2412" height="30" as="geometry"/></mxCell><mxCell id="p2_c2" value="Lệnh bảo trì định kỳ là một CASE loại &quot;Định kỳ&quot; (1 lệnh = 1 thiết bị): do hệ thống sinh nên KHÔNG có Pending / Rejected, vào thẳng Approved hoặc Assigned (BR-06). Giờ làm việc theo lịch của tòa (O04 của F3).&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · xám viền đứt = việc NGOÀI hệ thống · ①–⑬ = đường chính · ⏱ = thời gian · ↩ = quay lại · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy · thẻ AI = điểm AI hỗ trợ." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="2412" height="48" as="geometry"/></mxCell><mxCell id="p2_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="2432" height="330" as="geometry"/></mxCell><mxCell id="p2_c4" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="330" as="geometry"/></mxCell><mxCell id="p2_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="430" width="2432" height="320" as="geometry"/></mxCell><mxCell id="p2_c6" value="Officer&lt;br&gt;phụ trách tòa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="430" width="130" height="320" as="geometry"/></mxCell><mxCell id="p2_c7" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="750" width="2432" height="160" as="geometry"/></mxCell><mxCell id="p2_c8" value="Khách hàng&lt;br&gt;(người thuê /&lt;br&gt;cư dân)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="750" width="130" height="160" as="geometry"/></mxCell><mxCell id="p2_s_job" value="⏱ JOB NỀN mỗi ngày: kỳ&lt;br&gt;nào tới (ngày đến hạn −&lt;br&gt;lead time)? (BR-06)" style="whiteSpace=wrap;html=1;fillColor=#1d2b4f;strokeColor=#1d2b4f;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;ellipse;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="154" y="155" width="186" height="80" as="geometry"/></mxCell><mxCell id="p2_dRet" value="Thiết bị đã&lt;br&gt;thanh lý?" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="392" y="151" width="140" height="88" as="geometry"/></mxCell><mxCell id="p2_s_drop" value="Bỏ thiết bị khỏi kế&lt;br&gt;hoạch (F1 Trang 4)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="378" y="310" width="170" height="60" as="geometry"/></mxCell><mxCell id="p2_e_drop" value="KẾT THÚC&lt;br&gt;(không sinh lệnh)" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=doubleEllipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="172" y="313" width="150" height="54" as="geometry"/></mxCell><mxCell id="p2_dRecent" value="Đang sửa / ngừng&lt;br&gt;dùng, có case hoặc&lt;br&gt;LỆNH KỲ TRƯỚC còn mở,&lt;br&gt;hoặc VỪA SỬA XONG&lt;br&gt;≤ N ngày?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="602" y="130" width="190" height="130" as="geometry"/></mxCell><mxCell id="p2_s_sug" value="Báo Officer phụ trách:&lt;br&gt;hiện case gần nhất,&lt;br&gt;ngày sửa, kết quả" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="610" y="305" width="176" height="70" as="geometry"/></mxCell><mxCell id="p2_ai_sug" value="AI · gợi ý GIỮ hay DỜI kỳ&lt;br&gt;từ lịch sử sửa, tuổi thiết&lt;br&gt;bị, mức độ ảnh hưởng;&lt;br&gt;Officer quyết định" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=14;dashed=1;dashPattern=4 3;fillColor=#E8F0FE;strokeColor=#1A56DB;" vertex="1" parent="1"><mxGeometry x="838" y="300" width="190" height="80" as="geometry"/></mxCell><mxCell id="p2_op_N" value="OPEN P04: N bao nhiêu ngày? Đề xuất: = cửa sổ đúng hạn (10% chu kỳ). Case sửa có kiểm tra đủ hạng mục của checklist thì được tính thay kỳ này?" style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1062" y="292" width="230" height="96" as="geometry"/></mxCell><mxCell id="p2_dDefer" value="Officer&lt;br&gt;chọn?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="852" y="478" width="120" height="84" as="geometry"/></mxCell><mxCell id="p2_o_skip" value="BỎ kỳ + LÝ DO; KHÔNG&lt;br&gt;được bỏ kỳ kiểm định&lt;br&gt;bắt buộc" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="384" y="485" width="176" height="70" as="geometry"/></mxCell><mxCell id="p2_e_skip" value="KẾT THÚC kỳ này&lt;br&gt;(bỏ; F6 vẫn tính&lt;br&gt;vào mẫu số)" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=doubleEllipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="392" y="622" width="160" height="66" as="geometry"/></mxCell><mxCell id="p2_o_move" value="DỜI kỳ: ngày mới + LÝ DO&lt;br&gt;(chọn từ danh sách); kiểm&lt;br&gt;định bắt buộc chỉ dời&lt;br&gt;trong cửa sổ đúng hạn" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="814" y="613" width="196" height="84" as="geometry"/></mxCell><mxCell id="p2_e_move" value="KẾT THÚC lần này&lt;br&gt;(F6 đếm số lần dời)" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=doubleEllipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1072" y="625" width="170" height="60" as="geometry"/></mxCell><mxCell id="p2_t_dec" value="⏱ Officer chưa chọn trước&lt;br&gt;ngày đến hạn → hệ thống sinh&lt;br&gt;lệnh như bình thường (không&lt;br&gt;để mất kỳ)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="578" y="615" width="200" height="80" as="geometry"/></mxCell><mxCell id="p2_s_gen" value="Sinh LỆNH BẢO TRÌ ĐỊNH KỲ&lt;br&gt;(mỗi thiết bị 1 lệnh): checklist&lt;br&gt;SAO CHÉP từ kế hoạch, hạn =&lt;br&gt;ngày đến hạn, BỎ QUA duyệt" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1258" y="152" width="210" height="86" as="geometry"/></mxCell><mxCell id="p2_dImpact" value="Ảnh hưởng khách?&lt;br&gt;(khu thuê; cắt điện,&lt;br&gt;nước; dừng thang&lt;br&gt;máy)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1512" y="139" width="170" height="112" as="geometry"/></mxCell><mxCell id="p2_s_notify" value="Báo trước khách / đại diện&lt;br&gt;khu bị ảnh hưởng + đăng&lt;br&gt;THÔNG BÁO BẢO TRÌ; khu&lt;br&gt;thuê cần HẸN giờ vào" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1500" y="298" width="196" height="84" as="geometry"/></mxCell><mxCell id="p2_x_cus" value="Khách nhận thông báo, nắm lịch; khu thuê: hẹn giờ cho vào (điện thoại / bình luận trên lệnh). Không chặn việc sinh lệnh." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1468" y="797" width="260" height="66" as="geometry"/></mxCell><mxCell id="p2_op_notice" value="OPEN P05: báo trước bao lâu? Đề xuất: = lead time (3 ngày); cắt điện / nước toàn tòa theo nội quy tòa nhà." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1912" y="790" width="230" height="80" as="geometry"/></mxCell><mxCell id="p2_dDef" value="Có người thực&lt;br&gt;hiện mặc định&lt;br&gt;còn hoạt động?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1762" y="