y"></mxGeometry></mxCell><mxCell id="p2_c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_o_tmp" target="p2_dT1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2_c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;dashed=1;dashPattern=5 4;endArrow=none;strokeColor=#8A94A6;strokeWidth=1.4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_t_silent" target="p2_dT1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2_c31" value="Từ chối" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_dT1" target="p2_g_rej"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2_c32" value="Nhận ngay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_dT1" target="p2_st_acc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2_c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_st_acc" target="p2_c_p3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram name="F4-3 Xử lý tại hiện trường" id="p3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2202" pageHeight="1240" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3_c1" value="F4 · TRANG 3/5 — Xử lý tại hiện trường  (Accepted → Completed)" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2162" height="30" as="geometry"/></mxCell><mxCell id="p3_c2" value="Technician chỉ xử lý sự cố thông thường (N1); cần bên thứ 3 / linh kiện thì tạm dừng. Không kho, không tiền (N2, N22).&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · đỏ = MÂU THUẪN · xám viền đứt = việc NGOÀI hệ thống · ①–⑫ = đường chính · ⏱ = thời gian · ↩ = quay lại · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy 12/10 · thẻ AI = điểm AI hỗ trợ." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="2162" height="48" as="geometry"/></mxCell><mxCell id="p3_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="2182" height="160" as="geometry"/></mxCell><mxCell id="p3_c4" value="Officer&lt;br&gt;phụ trách tòa&lt;br&gt;/ Officer trực" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="160" as="geometry"/></mxCell><mxCell id="p3_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="260" width="2182" height="450" as="geometry"/></mxCell><mxCell id="p3_c6" value="Technician" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="260" width="130" height="450" as="geometry"/></mxCell><mxCell id="p3_c7" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="710" width="2182" height="180" as="geometry"/></mxCell><mxCell id="p3_c8" value="Bên thứ 3 /&lt;br&gt;ngoài hệ&lt;br&gt;thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="710" width="130" height="180" as="geometry"/></mxCell><mxCell id="p3_c9" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="890" width="2182" height="170" as="geometry"/></mxCell><mxCell id="p3_c10" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="890" width="130" height="170" as="geometry"/></mxCell><mxCell id="p3_c11" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="1060" width="2182" height="150" as="geometry"/></mxCell><mxCell id="p3_c12" value="Facility&lt;br&gt;Manager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="1060" width="130" height="150" as="geometry"/></mxCell><mxCell id="p3_c_in3x" value="⇢ từ Trang 2&lt;br&gt;(Accepted)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="182" y="332" width="130" height="56" as="geometry"/></mxCell><mxCell id="p3_t_start" value="Đến hiện trường,&lt;br&gt;bấm Bắt đầu" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="388" y="332" width="150" height="56" as="geometry"/></mxCell><mxCell id="p3_st_inp" value="In Progress" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="602" y="340" width="132" height="40" as="geometry"/></mxCell><mxCell id="p3_t_ctrl" value="KHỐNG CHẾ TRƯỚC: ngắt điện /&lt;br&gt;khóa van / dừng thang, đặt biển&lt;br&gt;cảnh báo, chụp ảnh → bấm &quot;Đã&lt;br&gt;an toàn&quot; (lưu mốc thời gian)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="790" y="317" width="206" height="86" as="geometry"/></mxCell><mxCell id="p3_op_contain" value="OPEN K06: 4 h khắc phục là bất khả thi khi chờ bên thứ 3 (thang máy). Đề xuất 2 mốc: &quot;khống chế xong&quot; (SLA cứng, vd. 1 h) và &quot;khắc phục xong&quot; (hạn điều chỉnh có lý do)." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="528" y="445" width="240" height="110" as="geometry"/></mxCell><mxCell id="p3_ai_tech" value="AI · gợi ý các bước an toàn + hướng xử lý theo loại dịch vụ và lịch sử thiết bị (chỉ tham khảo)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=14;dashed=1;dashPattern=4 3;fillColor=#E8F0FE;strokeColor=#1A56DB;" vertex="1" parent="1"><mxGeometry x="810" y="588" width="206" height="84" as="geometry"/></mxCell><mxCell id="p3_dFix" value="Khắc phục xong&lt;br&gt;tại chỗ? (sự cố&lt;br&gt;thông thường)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1046" y="310" width="164" height="100" as="geometry"/></mxCell><mxCell id="p3_t_fix" value="Ghi nhận sửa chữa (bắt buộc):&lt;br&gt;NỘI DUNG ĐÃ LÀM, NGUYÊN NHÂN&lt;br&gt;GỐC (RootCause), linh kiện ghi&lt;br&gt;tay, giờ công, ảnh trước / sau" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1248" y="317" width="210" height="86" as="geometry"/></mxCell><mxCell id="p3_t_comp" value="Báo hoàn thành&lt;br&gt;(DLG-11)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1498" y="332" width="140" height="56" as="geometry"/></mxCell><mxCell id="p3_st_comp" value="Completed" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1696" y="340" width="132" height="40" as="geometry"/></mxCell><mxCell id="p3_c_p4" value="⇢ Trang 4&lt;br&gt;Nghiệm thu" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1902" y="332" width="130" height="56" as="geometry"/></mxCell><mxCell id="p3_t_hold" value="Tạm dừng (DLG-10), lý do:&lt;br&gt;&quot;chờ bên thứ 3&quot; / &quot;chờ linh&lt;br&gt;kiện&quot;; biện pháp tạm vẫn áp&lt;br&gt;dụng; báo khách giờ dự kiến" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1048" y="457" width="200" height="86" as="geometry"/></mxCell><mxCell id="p3_st_hold" value="On Hold" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1296" y="480" width="132" height="40" as="geometry"/></mxCell><mxCell id="p3_t_holdclk" value="⏱ Đề xuất: với KHẨN CẤP, On Hold&lt;br&gt;KHÔNG dừng đồng hồ (khác BR-08);&lt;br&gt;Officer đặt hạn điều chỉnh có lý do&lt;br&gt;→ hạn có hiệu lực = hạn dài hơn" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1268" y="587" width="230" height="86" as="geometry"/></mxCell><mxCell id="p3_x_v2" value="Bên thứ 3 cứu hộ / sửa, hoặc&lt;br&gt;mua linh kiện (ngoài hệ thống,&lt;br&gt;không kho, không tiền)" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;dashed=1;dashPattern=8 4;fillColor=#F4F4F5;strokeColor=#71717A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1448" y="765" width="200" height="70" as="geometry"/></mxCell><mxCell id="p3_note_vrec" value="Officer ghi nhận chuyển bên thứ 3 trên case (tên, liên hệ, giờ gọi / đến) như F5 — kể cả bên không có hợp đồng." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="712" y="768" width="400" height="64" as="geometry"/></mxCell><mxCell id="p3_g_resume" value="↩ Technician kiểm tra, Tiếp&lt;br&gt;tục (Resume) → In Progress,&lt;br&gt;rồi ghi nhận sửa chữa (⑨)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=40;dashed=1;dashPattern=2 3;" vertex="1" parent="1"><mxGeometry x="1662" y="595" width="200" height="70" as="geometry"/></mxCell><mxCell id="p3_note_cost" value="Chi phí bên thứ 3 khi khẩn cấp: LÀM TRƯỚC, ghi bên chịu chi phí + bằng chứng ở bước ⑪ (Trang 4). Không lưu số tiền, không duyệt (N22)." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1842" y="763" width="330" height="74" as="geometry"/></mxCell><mxCell id="p3_note_track" value="Officer theo dõi trực tiếp (OFF-03), cập nhật khách theo mốc: &quot;đã có người&quot;, &quot;đã an toàn&quot;, &quot;dự kiến xong lúc …&quot;." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="498" y="150" width="440" height="60" as="geometry"/></mxCell><mxCell id="p3_sys_sla" value="Theo dõi đồng hồ KHẨN CẤP 24/7&lt;br&gt;(không theo giờ hành chính): gần&lt;br&gt;hạn → Officer; quá hạn → cờ đỏ +&lt;br&gt;báo Manager" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="604" y="933" width="226" height="84" as="geometry"/></mxCell><mxCell id="p3_m1" value="Nhận thông báo quá hạn;&lt;br&gt;MGR-01 &quot;Cần chú ý&quot; —&lt;br&gt;chỉ xem (BR-12)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="622" y="1102" width="190" height="66" as="geometry"/></mxCell><mxCell id="p3_e_m2" value="KẾT THÚC" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=doubleEllipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="902" y="1112" width="120" height="46" as="geometry"/></mxCell><mxCell id="p3_c13" value="⑧" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#