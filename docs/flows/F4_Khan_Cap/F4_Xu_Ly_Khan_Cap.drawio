<diagram name="F4-4 Nghiệm thu &amp; sau sự cố" id="p4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2162" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4_c1" value="F4 · TRANG 4/5 — Nghiệm thu, đóng và báo cáo sau sự cố  (Completed → Closed)" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2122" height="30" as="geometry"/></mxCell><mxCell id="p4_c2" value="Chỉ Officer đóng hoặc mở lại (BR-13). Thứ tự sửa so với bản tuần 4: kiểm tra → đóng → khách đánh giá (bản cũ đóng trước, khách xác nhận sau).&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · đỏ = MÂU THUẪN · xám viền đứt = việc NGOÀI hệ thống · ①–⑫ = đường chính · ⏱ = thời gian · ↩ = quay lại · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy 12/10 · thẻ AI = điểm AI hỗ trợ." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="2122" height="48" as="geometry"/></mxCell><mxCell id="p4_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="2142" height="220" as="geometry"/></mxCell><mxCell id="p4_c4" value="Khách hàng&lt;br&gt;(người thuê /&lt;br&gt;cư dân)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="220" as="geometry"/></mxCell><mxCell id="p4_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="320" width="2142" height="400" as="geometry"/></mxCell><mxCell id="p4_c6" value="Officer&lt;br&gt;phụ trách tòa&lt;br&gt;/ Officer trực" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="320" width="130" height="400" as="geometry"/></mxCell><mxCell id="p4_c7" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="720" width="2142" height="250" as="geometry"/></mxCell><mxCell id="p4_c8" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="720" width="130" height="250" as="geometry"/></mxCell><mxCell id="p4_c_in4" value="⇢ từ Trang 3" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="182" y="507" width="130" height="56" as="geometry"/></mxCell><mxCell id="p4_st_comp3" value="Completed" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="396" y="515" width="132" height="40" as="geometry"/></mxCell><mxCell id="p4_o_ver" value="Kiểm tra kết quả (OFF-04): nội&lt;br&gt;dung sửa + ảnh; với khẩn cấp:&lt;br&gt;gọi khách / xem tại chỗ xác&lt;br&gt;nhận ĐÃ AN TOÀN" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="578" y="492" width="200" height="86" as="geometry"/></mxCell><mxCell id="p4_op_vmeth" value="OPEN K07: có cần trạng thái &quot;chờ khách xác nhận&quot; không? Đề xuất KHÔNG (R3 không có, khách vẫn báo &quot;Chưa sửa xong&quot; trong 7 ngày); Officer ghi &quot;đã xác nhận với khách&quot; khi đóng." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="568" y="590" width="240" height="100" as="geometry"/></mxCell><mxCell id="p4_dV1" value="Kết quả&lt;br&gt;đạt?" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="822" y="493" width="140" height="84" as="geometry"/></mxCell><mxCell id="p4_o_reopen" value="Mở lại (DLG-07): lý do + hạn&lt;br&gt;mới; báo Technician + khách" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="794" y="375" width="196" height="60" as="geometry"/></mxCell><mxCell id="p4_st_reop" value="Reopened" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="612" y="385" width="132" height="40" as="geometry"/></mxCell><mxCell id="p4_c_back" value="⇢ Trang 2, bước ⑦&lt;br&gt;Technician nhận lại&lt;br&gt;(vẫn khẩn cấp, 24/7)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="338" y="370" width="170" height="70" as="geometry"/></mxCell><mxCell id="p4_o_close" value="Đóng (DLG-06): GHI BÊN CHỊU CHI&lt;br&gt;PHÍ (tòa / khách) + bằng chứng nếu&lt;br&gt;có bên thứ 3; kết thúc biện pháp&lt;br&gt;tạm; tùy chọn trả thiết bị Active" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1026" y="492" width="222" height="86" as="geometry"/></mxCell><mxCell id="p4_st_closed" value="Closed" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1296" y="515" width="132" height="40" as="geometry"/></mxCell><mxCell id="p4_l_F2r" value="→ F3 Trang 4: khách đánh giá / báo&lt;br&gt;&quot;Chưa sửa xong&quot; (≤ 7 ngày, BR-03);&lt;br&gt;nếu mở lại → về F4 Trang 2 bước ⑦" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1244" y="175" width="236" height="70" as="geometry"/></mxCell><mxCell id="p4_s_close" value="Tắt cờ &quot;đang khẩn cấp&quot; (mức ưu&lt;br&gt;tiên Khẩn cấp vẫn giữ để báo cáo);&lt;br&gt;lưu mốc báo → xác nhận → an toàn&lt;br&gt;→ khắc phục; ghi lịch sử thiết bị;&lt;br&gt;báo khách + case gộp" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1250" y="766" width="226" height="98" as="geometry"/></mxCell><mxCell id="p4_o_review" value="BÁO CÁO SAU SỰ CỐ: thiệt hại,&lt;br&gt;bài học, đề xuất phòng ngừa&lt;br&gt;(nguyên nhân gốc lấy từ ghi&lt;br&gt;nhận của Technician ở ⑨)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1496" y="492" width="204" height="86" as="geometry"/></mxCell><mxCell id="p4_op_review" value="OPEN K08: báo cáo sau sự cố bắt buộc với MỌI case khẩn cấp hay chỉ khi có thiệt hại / quá hạn? R3 chưa có biểu mẫu này." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1482" y="360" width="230" height="90" as="geometry"/></mxCell><mxCell id="p4_dPrev" value="Cần phòng&lt;br&gt;ngừa?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1752" y="493" width="140" height="84" as="geometry"/></mxCell><mxCell id="p4_l_F4" value="→ F2 lập kế hoạch&lt;br&gt;định kỳ" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1968" y="377" width="160" height="56" as="geometry"/></mxCell><mxCell id="p4_l_F5" value="→ F5 (cách 2) xem&lt;br&gt;xét sửa hay thay" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1962" y="612" width="170" height="56" as="geometry"/></mxCell><mxCell id="p4_e_end" value="KẾT THÚC" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=doubleEllipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1988" y="512" width="120" height="46" as="geometry"/></mxCell><mxCell id="p4_c9" value="⑩" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="566" y="480" width="26" height="26" as="geometry"/></mxCell><mxCell id="p4_c10" value="N21" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="744" y="481" width="31" height="18" as="geometry"/></mxCell><mxCell id="p4_c11" value="⑪" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1014" y="480" width="26" height="26" as="geometry"/></mxCell><mxCell id="p4_c12" value="G2" style="rounded=1;arcSize=40;html=1;fillCol