<mxfile host="app.diagrams.net" agent="SmartMaint-generator">
<diagram name="F4-1 Tiếp nhận" id="p1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2677" pageHeight="1270" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_c1" value="F4 · TRANG 1/5 — Tiếp nhận và xác nhận khẩn cấp  (từ lúc case được tạo đến khi Officer xác nhận đúng là khẩn cấp)" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2637" height="30" as="geometry"/></mxCell><mxCell id="p1_c2" value="Case được TẠO ở F3 bước ① (khách gửi, hoặc Officer nhập thay khi khách gọi hotline); loại dịch vụ thuộc danh sách khẩn cấp (N26, F1) thì sang đây ngay, bỏ qua Pending. Officer trực = Officer có ca trực ngoài giờ theo lịch trực (đề xuất, xem OPEN về lịch trực). Officer dự phòng = người Admin gán thay khi Officer phụ trách vắng (F1 bước ③).&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · đỏ = MÂU THUẪN · xám viền đứt = việc NGOÀI hệ thống · ①–⑫ = đường chính · ⏱ = thời gian · ↩ = quay lại · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy 12/10 · thẻ AI = điểm AI hỗ trợ." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="2637" height="48" as="geometry"/></mxCell><mxCell id="p1_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="2657" height="260" as="geometry"/></mxCell><mxCell id="p1_c4" value="Khách hàng&lt;br&gt;(người thuê /&lt;br&gt;cư dân)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="260" as="geometry"/></mxCell><mxCell id="p1_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="360" width="2657" height="430" as="geometry"/></mxCell><mxCell id="p1_c6" value="Officer&lt;br&gt;phụ trách tòa&lt;br&gt;/ Officer trực" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="360" width="130" height="430" as="geometry"/></mxCell><mxCell id="p1_c7" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="790" width="2657" height="300" as="geometry"/></mxCell><mxCell id="p1_c8" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="790" width="130" height="300" as="geometry"/></mxCell><mxCell id="p1_c9" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="1090" width="2657" height="150" as="geometry"/></mxCell><mxCell id="p1_c10" value="Facility&lt;br&gt;Manager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="1090" width="130" height="150" as="geometry"/></mxCell><mxCell id="p1_c_in1" value="⇢ từ F3 Trang 1: case MỚI&lt;br&gt;có loại dịch vụ khẩn cấp" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="152" y="845" width="190" height="70" as="geometry"/></mxCell><mxCell id="p1_s_create" value="Đặt mức KHẨN CẤP theo loại&lt;br&gt;dịch vụ, vào thẳng Approved&lt;br&gt;(bỏ Pending), bắt đầu đồng hồ&lt;br&gt;24/7: phản hồi 1 h, khắc phục 4 h" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="837" width="206" height="86" as="geometry"/></mxCell><mxCell id="p1_red_br" value="MÂU THUẪN với R3: BR-01 (Officer đặt mức cuối khi duyệt) và BR-08 (Urgent đếm theo giờ làm việc). F4 đề xuất mức do loại dịch vụ đặt sẵn + đếm 24/7 → phải sửa BR-01, BR-08 và xin thầy chốt." style="whiteSpace=wrap;html=1;fillColor=#FADADA;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="354" y="953" width="236" height="104" as="geometry"/></mxCell><mxCell id="p1_st_appr" value="Approved" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642" y="860" width="132" height="40" as="geometry"/></mxCell><mxCell id="p1_c_f2" value="⇢ từ F3 Trang 1:&lt;br&gt;Officer chốt Khẩn&lt;br&gt;cấp khi duyệt" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="662" y="970" width="150" height="70" as="geometry"/></mxCell><mxCell id="p1_s_notify" value="Báo ĐÚNG NGƯỜI: trong giờ → Officer&lt;br&gt;phụ trách tòa; ngoài giờ → Officer&lt;br&gt;TRỰC; đẩy thông báo + SMS. Báo khách&lt;br&gt;&quot;đã tiếp nhận&quot; + hướng dẫn an toàn" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="828" y="837" width="230" height="86" as="geometry"/></mxCell><mxCell id="p1_op_duty" value="OPEN K02: ngoài giờ ai nhận? Đề xuất: Admin cấu hình LỊCH TRỰC (Officer + Technician trực theo ca) — R3 chưa có vai trò / lịch trực. Hay chỉ hotline ngoài hệ thống, hệ thống ghi nhận sau?" style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="844" y="953" width="236" height="104" as="geometry"/></mxCell><mxCell id="p1_note_life" value="Nguy hiểm tính mạng (cháy, rò gas, người kẹt thang máy): gọi 114 / 115 và hotline ban quản lý TRƯỚC. Hệ thống KHÔNG thay thế báo cháy / BMS, không tự gọi 114." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="742" y="150" width="420" height="70" as="geometry"/></mxCell><mxCell id="p1_op_g2" value="OPEN K01 (G2 &quot;mai cần dùng phòng họp&quot;): không phải khẩn cấp theo N26 → F3 mức Cao + trường &quot;cần dùng trước&quot; (chỉ để Officer xếp lịch, không đổi SLA)? Bản tuần 4 đưa vào F4." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="352" y="130" width="240" height="110" as="geometry"/></mxCell><mxCell id="p1_o_ack" value="Xác nhận ĐÃ NHẬN (1 chạm,&lt;br&gt;cả trên mobile) → dừng&lt;br&gt;đồng hồ &quot;phản hồi đầu&quot;" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1054" y="544" width="186" height="72" as="geometry"/></mxCell><mxCell id="p1_ai1" value="AI · gợi ý case trùng cùng tòa trong 60 phút gần nhất + hướng dẫn an toàn theo loại dịch vụ; Officer quyết định" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=14;dashed=1;dashPattern=4 3;fillColor=#E8F0FE;strokeColor=#1A56DB;" vertex="1" parent="1"><mxGeometry x="1258" y="403" width="210" height="84" as="geometry"/></mxCell><mxCell id="p1_o_view" value="Xem case + ảnh + lịch&lt;br&gt;sử thiết bị (AST-03);&lt;br&gt;gọi lại khách nếu cần" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1274" y="544" width="176" height="72" as="geometry"/></mxCell><mxCell id="p1_dDup" value="Trùng sự cố đang&lt;br&gt;xử lý? (mất điện&lt;br&gt;cả tầng, nhiều&lt;br&gt;người báo)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1492" y="525" width="170" height="110" as="geometry"/></mxCell><mxCell id="p1_o_merge" value="Gộp vào case chính (N5);&lt;br&gt;case con khóa, không tính&lt;br&gt;KPI, được báo khi xong" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1482" y="410" width="190" height="70" as="geometry"/></mxCell><mxCell id="p1_end_merge" value="KẾT THÚC&lt;br&gt;case gộp" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=doubleEllipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1748" y="420" width="130" height="50" as="geometry"/></mxCell><mxCell id="p1_dReal" value="Đúng là&lt;br&gt;khẩn cấp?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1738" y="535" width="150" height="90" as="geometry"/></mxCell><mxCell id="p1_dWhy" value="Vẫn là sự cố&lt;br&gt;trong phạm vi&lt;br&gt;tòa nhà?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1734" y="657" width="156" height="96" as="geometry"/></mxCell><mxCell id="p1_o_canc" value="Hủy (DLG-12): &quot;báo nhầm&quot; /&lt;br&gt;&quot;ngoài phạm vi tòa nhà&quot;,&lt;br&gt;lý do ≥ 10 ký tự, báo khách" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1440" y="670" width="196" height="70" as="geometry"/></mxCell><mxCell id="p1_st_can" value="Cancelled" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1256" y="685" width="132" height="40" as="geometry"/></mxCell><mxCell id="p1_o_down" value="Hạ mức (Cao / Bình thường /&lt;br&gt;Thấp) + lý do; GHI BÊN CHỊU&lt;br&gt;CHI PHÍ như F3 ④; báo khách;&lt;br&gt;đồng hồ theo giờ hành chính" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1944" y="662" width="206" height="86" as="geometry"/></mxCell><mxCell id="p1_l_F2" value="→ F3 Trang 2&lt;br&gt;(Approved, giao việc)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2208" y="677" width="170" height="56" as="geometry"/></mxCell><mxCell id="p1_op_down" value="OPEN K04: hạ mức có bị lạm dụng để né SLA 4 h không? Đề xuất: chỉ hạ TRƯỚC khi giao việc; F6 đếm riêng số case bị hạ mức." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="2428" y="657" width="220" height="96" as="geometry"/></mxCell><mxCell id="p1_c_p2" value="⇢ Trang 2&lt;br&gt;Điều phối" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2208" y="552" width="130" height="56" as="geometry"/></mxCell><mxCell id="p1_s_esc" value="⏱ Chưa xác nhận sau 10 phút →&lt;br&gt;nhắc lại + báo Officer DỰ PHÒNG;&lt;br&gt;sau 30 phút → báo Manager&lt;br&gt;(số phút chỉnh ở ADM-07)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1488" y="838" width="220" height="84" as="geometry"/></mxCell><mxCell id="p1_m_esc" value="Nhận cảnh báo (COM-08),&lt;br&gt;&quot;Cần chú ý&quot; MGR-01 —&lt;br&gt;chỉ xem (BR-12)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1500" y="1132" width="196" height="66" as="geometry"/></mxCell><mxCell id="p1_e_m" value="KẾT THÚC" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=doubleEllipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1792" y="1142" width="120" height="46" as="geometry"/></mxCell><mxCell id="p1_op_esc" value="OPEN K03 (N14, O10 của F3): Manager chỉ xem → cảnh báo để làm gì? Đề xuất: Manager gọi điện chỉ đạo NGOÀI hệ thống; hệ thống chỉ lưu &quot;đã báo Manager lúc …&quot;." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="2018" y="1122" width="330" height="86" as="geometry"/></mxCell><mxCell id="p1_note_scope" value="PHẠM VI (N23): khẩn cấp luôn KHỐNG CHẾ TRƯỚC (vd. ống nước trong căn hộ vỡ tràn xuống tầng dưới: tòa vẫn khóa van ngay). Bên chịu chi phí ghi ở bước ⑪ khi đóng (hoặc khi hạ mức)." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1788" y="840" widt