<diagram name="F4-2 Điều phối" id="p2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2122" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_c1" value="F4 · TRANG 2/5 — Điều phối: gọi bên thứ 3 (nếu có hợp đồng), giao Technician, biện pháp tạm  (Approved → Accepted)" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2082" height="30" as="geometry"/></mxCell><mxCell id="p2_c2" value="Giữ BR-20: Approved và Assigned là 2 bước riêng (hệ thống tự duyệt, Officer giao) — bản tuần 4 gộp &quot;Approve + Assign một bước&quot;. Thang máy, PCCC, điện trung thế… do bên thứ 3 có hợp đồng (N1).&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · đỏ = MÂU THUẪN · xám viền đứt = việc NGOÀI hệ thống · ①–⑫ = đường chính · ⏱ = thời gian · ↩ = quay lại · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy 12/10 · thẻ AI = điểm AI hỗ trợ." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="2082" height="48" as="geometry"/></mxCell><mxCell id="p2_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="2102" height="430" as="geometry"/></mxCell><mxCell id="p2_c4" value="Officer&lt;br&gt;phụ trách tòa&lt;br&gt;/ Officer trực" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="430" as="geometry"/></mxCell><mxCell id="p2_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="530" width="2102" height="290" as="geometry"/></mxCell><mxCell id="p2_c6" value="Technician" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="530" width="130" height="290" as="geometry"/></mxCell><mxCell id="p2_c7" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="820" width="2102" height="150" as="geometry"/></mxCell><mxCell id="p2_c8" value="Facility&lt;br&gt;Manager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="820" width="130" height="150" as="geometry"/></mxCell><mxCell id="p2_c_in2" value="⇢ từ Trang 1" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="182" y="297" width="130" height="56" as="geometry"/></mxCell><mxCell id="p2_st_appr2" value="Approved" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="396" y="305" width="132" height="40" as="geometry"/></mxCell><mxCell id="p2_dWho" value="Loại dịch vụ có&lt;br&gt;hợp đồng bên&lt;br&gt;thứ 3? (thang máy,&lt;br&gt;PCCC, điện TT)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="592" y="269" width="172" height="112" as="geometry"/></mxCell><mxCell id="p2_o_vcall" value="Gọi NGAY đơn vị hợp đồng&lt;br&gt;(điện thoại) + ghi nhận: tên,&lt;br&gt;giờ gọi, giờ hẹn đến" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="580" y="149" width="196" height="72" as="geometry"/></mxCell><mxCell id="p2_o_asg" value="Giao Technician (DLG-04): chỉ&lt;br&gt;người ĐANG TRONG CA / TRỰC,&lt;br&gt;đúng chuyên môn; là đầu mối&lt;br&gt;kể cả khi bên thứ 3 làm" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="810" y="282" width="206" height="86" as="geometry"/></mxCell><mxCell id="p2_dAvail" value="Có Technician&lt;br&gt;trong ca?" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1062" y="281" width="150" height="88" as="geometry"/></mxCell><mxCell id="p2_op_oncall" value="OPEN K05: lịch ca / trực của Technician quản lý ở đâu (R3 chưa có)? Không ai nhận: gọi Technician nghỉ ca, hay chuyển hẳn bên thứ 3?" style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1058" y="137" width="220" height="96" as="geometry"/></mxCell><mxCell id="p2_o_oncall" value="Gọi Technician trực ngoài giờ;&lt;br&gt;không ai → gọi bên thứ 3 và&lt;br&gt;giao Technician ca KẾ TIẾP&lt;br&gt;làm đầu mối" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1038" y="404" width="200" height="82" as="geometry"/></mxCell><mxCell id="p2_g_asg" value="↩ Có người nhận:&lt;br&gt;giao ở bước ⑤" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=40;dashed=1;dashPattern=2 3;" vertex="1" parent="1"><mxGeometry x="812" y="418" width="160" height="54" as="geometry"/></mxCell><mxCell id="p2_st_asg" value="Assigned" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1286" y="305" width="132" height="40" as="geometry"/></mxCell><mxCell id="p2_o_tmp" value="Trong lúc Technician di chuyển —&lt;br&gt;BIỆN PHÁP TẠM: báo công ty thuê /&lt;br&gt;cư dân bị ảnh hưởng, phòng / thiết&lt;br&gt;bị thay thế (CHỈ GHI NHẬN chữ,&lt;br&gt;không quản lý mượn trả)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1474" y="277" width="226" height="96" as="geometry"/></mxCell><mxCell id="p2_note_off" value="Officer có thể bất cứ lúc nào (như F3): Giao lại (DLG-05, lý do, KHÔNG reset đồng hồ) hoặc Hủy (DLG-12, lý do ≥ 10 ký tự) từ Approved / Assigned / Accepted / In Progress / On Hold / Reopened." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1572" y="147" width="480" height="76" as="geometry"/></mxCell><mxCell id="p2_g_rej" value="↩ Từ chối + lý do (chỉ trước&lt;br&gt;khi nhận, BR-13) → về Approved:&lt;br&gt;Officer giao người khác NGAY" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=40;dashed=1;dashPattern=2 3;" vertex="1" parent="1"><mxGeometry x="1240" y="595" width="206" height="70" as="geometry"/></mxCell><mxCell id="p2_dT1" value="Nhận việc?" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1518" y="588" width="140" height="84" as="geometry"/></mxCell><mxCell id="p2_t_silent" value="⏱ Assigned quá 10 phút chưa Nhận&lt;br&gt;→ chuông lại + báo Officer" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#