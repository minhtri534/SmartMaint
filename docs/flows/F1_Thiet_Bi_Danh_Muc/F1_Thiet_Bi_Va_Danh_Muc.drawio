<diagram name="F1-4 Thay thế &amp; thanh lý" id="p4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1727" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4_c1" value="F1 · TRANG 4/5 — Thay thế và thanh lý thiết bị (kết thúc vòng đời)" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1687" height="30" as="geometry"/></mxCell><mxCell id="p4_c2" value="Admin KHÔNG xem nội dung case (BR-11) → yêu cầu Officer gửi Admin chỉ có mã thiết bị + lý do ngắn. Chỉ Admin thanh lý, bị chặn khi thiết bị còn case mở (BR-10).&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · đỏ = MÂU THUẪN · xám viền đứt = việc NGOÀI hệ thống · ①–⑦ = đường chính · ↩ = quay lại · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy 12/10." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1687" height="48" as="geometry"/></mxCell><mxCell id="p4_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="1707" height="300" as="geometry"/></mxCell><mxCell id="p4_c4" value="Officer&lt;br&gt;phụ trách tòa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="300" as="geometry"/></mxCell><mxCell id="p4_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="400" width="1707" height="330" as="geometry"/></mxCell><mxCell id="p4_c6" value="Admin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="400" width="130" height="330" as="geometry"/></mxCell><mxCell id="p4_c7" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="730" width="1707" height="220" as="geometry"/></mxCell><mxCell id="p4_c8" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="730" width="130" height="220" as="geometry"/></mxCell><mxCell id="p4_p4_s" value="BẮT ĐẦU — từ F5: đã&lt;br&gt;quyết định THAY, hoặc&lt;br&gt;thiết bị hết tuổi thọ" style="whiteSpace=wrap;html=1;fillColor=#1d2b4f;strokeColor=#1d2b4f;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;ellipse;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="158" y="157" width="180" height="66" as="geometry"/></mxCell><mxCell id="p4_o_req" value="Gửi &quot;Đề nghị thanh lý / thay&lt;br&gt;thiết bị&quot; cho Admin: mã thiết&lt;br&gt;bị + lý do ngắn, KHÔNG kèm&lt;br&gt;nội dung case (BR-11)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="147" width="206" height="86" as="geometry"/></mxCell><mxCell id="p4_op_req" value="OPEN A06: R3 chưa có kênh Officer → Admin. Đề xuất: thông báo hệ thống loại &quot;Yêu cầu dữ liệu thiết bị&quot; chỉ chứa mã thiết bị + lý do. Hay làm ngoài hệ thống?" style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="612" y="138" width="230" height="104" as="geometry"/></mxCell><mxCell id="p4_dOpen" value="Còn case mở hoặc&lt;br&gt;kế hoạch định kỳ&lt;br&gt;đang chạy? (BR-10)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="394" y="445" width="176" height="110" as="geometry"/></mxCell><mxCell id="p4_a_block" value="Nút Xác nhận bị khóa (DLG-17):&lt;br&gt;liệt kê case / kế hoạch chặn&lt;br&gt;(chỉ mã) → báo Officer" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="380" y="604" width="206" height="72" as="geometry"/></mxCell><mxCell id="p4_o_clear" value="Officer CHỜ case còn mở đóng&lt;br&gt;xong (F3 / F5, không hủy hồ sơ&lt;br&gt;thay) + gỡ thiết bị khỏi kế&lt;br&gt;hoạch định kỳ (PM-02, F2)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="634" y="279" width="206" height="72" as="geometry"/></mxCell><mxCell id="p4_dNew" value="Có thiết bị&lt;br&gt;thay thế?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="858" y="456" width="150" height="88" as="geometry"/></mxCell><mxCell id="p4_c_reg" value="Đăng ký thiết bị mới theo&lt;br&gt;Trang 2 (cách 2), ghi &quot;thay&lt;br&gt;cho &amp;lt;mã cũ&amp;gt;&quot;, in nhãn QR mới" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="832" y="604" width="200" height="72" as="geometry"/></mxCell><mxCell id="p4_a_retire" value="Thanh lý (DLG-17): gõ lại&lt;br&gt;mã thiết bị để xác nhận" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1094" y="469" width="186" height="62" as="geometry"/></mxCell><mxCell id="p4_st_ret" value="Retired" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1336" y="480" width="132" height="40" as="geometry"/></mxCell><mxCell id="p4_s_ret" value="Ẩn khỏi danh sách (công tắc &quot;Hiện&lt;br&gt;đã thanh lý&quot;), quét nhãn QR cũ&lt;br&gt;báo &quot;đã thanh lý&quot;; LỊCH SỬ GIỮ&lt;br&gt;NGUYÊN, không xóa thật (BR-10)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1296" y="782" width="214" height="86" as="geometry"/></mxCell><mxCell id="p4_e_ret" value="KẾT THÚC" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=doubleEllipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1578" y="802" width="120" height="46" as="geometry"/></mxCell><mxCell id="p4_op_chain" value="OPEN A07: liên kết &quot;thiết bị mới THAY CHO thiết bị cũ&quot; để xem lịch sử cả vị trí? R3 chưa có trường này; ERD Asset cần thêm khóa tự tham chiếu." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="818" y="777" width="230" height="96" as="geometry"/></mxCell><mxCell id="p4_c9" value="G4" style="rounded=1;arcSize=40;html=1;fillColor=#EDE4FA;strokeColor=#7B4FC9;fontColor=#4B2A8A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="558" y="136" width="26" height="18" as="geometry"/></mxCell><mxCell id="p4_c10" value="G4" style="rounded=1;arcSize=40;html=1;fillColor=#EDE4FA;strokeColor=#7B4FC9;fontColor=#4B2A8A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="814" y="127" width="26" height="18" as="geometry"/></mxCell><mxCell id="p4_c11" value="G4" style="rounded=1;arcSize=40;html=1;fillColor=#EDE4FA;strokeColor=#7B4FC9;fontColor=#4B2A8