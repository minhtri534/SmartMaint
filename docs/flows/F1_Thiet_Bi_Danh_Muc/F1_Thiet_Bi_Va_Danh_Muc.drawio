<diagram name="F1-5 Trạng thái thiết bị" id="p5"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1355" pageHeight="543" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5_c1" value="F1 · TRANG 5/5 — Bản đồ trạng thái THIẾT BỊ (4 trạng thái theo R3: Active, Under repair, Out of service, Retired)" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1315" height="30" as="geometry"/></mxCell><mxCell id="p5_c2" value="Mỗi mũi tên ghi ai (người nào) làm. Under repair / Out of service chỉ để thông tin, không chặn báo hỏng. Retired là trạng thái cuối, không quay lại (muốn dùng lại = đăng ký thiết bị mới). Kiểm tra tự động đối chiếu với Trang 2–4." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1315" height="48" as="geometry"/></mxCell><mxCell id="p5_m_start" value="BẮT ĐẦU&lt;br&gt;(Admin tạo / nhập file)" style="whiteSpace=wrap;html=1;fillColor=#1d2b4f;strokeColor=#1d2b4f;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;ellipse;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="25" y="273" width="170" height="54" as="geometry"/></mxCell><mxCell id="p5_m_A" value="Active" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="325" y="277" width="150" height="46" as="geometry"/></mxCell><mxCell id="p5_m_UR" value="Under repair" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="725" y="137" width="150" height="46" as="geometry"/></mxCell><mxCell id="p5_m_OOS" value="Out of service" style="whit