<diagram name="F1-1 Dữ liệu nền" id="p1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2112" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_c1" value="F1 · TRANG 1/5 — Dữ liệu nền: địa điểm, Officer phụ trách tòa, danh mục thiết bị và DANH MỤC DỊCH VỤ" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2072" height="30" as="geometry"/></mxCell><mxCell id="p1_c2" value="Làm một lần khi đưa tòa nhà vào hệ thống, sau đó sửa khi có thay đổi. Chỉ Admin tạo / sửa / ngừng dùng dữ liệu nền (BR-09). F3 và F4 đọc toàn bộ dữ liệu ở trang này.&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · đỏ = MÂU THUẪN · xám viền đứt = việc NGOÀI hệ thống · ①–⑦ = đường chính · ↩ = quay lại · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy 12/10." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="2072" height="48" as="geometry"/></mxCell><mxCell id="p1_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="2092" height="430" as="geometry"/></mxCell><mxCell id="p1_c4" value="Admin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="430" as="geometry"/></mxCell><mxCell id="p1_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="530" width="2092" height="200" as="geometry"/></mxCell><mxCell id="p1_c6" value="Officer&lt;br&gt;phụ trách tòa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="530" width="130" height="200" as="geometry"/></mxCell><mxCell id="p1_c7" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="730" width="2092" height="260" as="geometry"/></mxCell><mxCell id="p1_c8" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="730" width="130" height="260" as="geometry"/></mxCell><mxCell id="p1_p1_start" value="BẮT ĐẦU&lt;br&gt;đưa tòa nhà vào hệ&lt;br&gt;thống / thêm tòa mới" style="whiteSpace=wrap;html=1;fillColor=#1d2b4f;strokeColor=#1d2b4f;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;ellipse;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="168" y="159" width="160" height="62" as="geometry"/></mxCell><mxCell id="p1_a_loc" value="Tạo cây địa điểm (AST-01,&lt;br&gt;DLG-15): Tòa → Tầng → Phòng,&lt;br&gt;tên + mã duy nhất" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="368" y="153" width="190" height="74" as="geometry"/></mxCell><mxCell id="p1_a_zone" value="Gắn LOẠI KHU cho từng phòng:&lt;br&gt;KHU CHUNG (sảnh, hành lang, phòng&lt;br&gt;kỹ thuật…) hoặc KHU THUÊ / CĂN HỘ&lt;br&gt;(+ công ty thuê / chủ hộ)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="570" y="146" width="214" height="88" as="geometry"/></mxCell><mxCell id="p1_op_zone" value="OPEN A01: lưu ĐẠI DIỆN HỢP ĐỒNG của từng công ty thuê / căn hộ (người nhận báo giá, O13 của F3)? Liên kết tài khoản khách ↔ phòng thuê thế nào khi một công ty thuê nhiều phòng / tầng?" style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="562" y="395" width="230" height="110" as="geometry"/></mxCell><mxCell id="p1_a_off" value="Gán Officer PHỤ TRÁCH cho từng&lt;br&gt;tòa (+ người dự phòng); thay&lt;br&gt;BR-19 &quot;hàng chờ chung&quot; (đề xuất,&lt;br&gt;chờ chốt O02 / S01)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="792" y="147" width="200" height="86" as="geometry"/></mxCell><mxCell id="p1_op_off" value="OPEN A02 (O02 của F3): đổi / nghỉ việc Officer phụ trách → case đang mở của tòa chuyển cho ai? Ai bật &quot;vắng mặt&quot;?" style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="818" y="402" width="210" height="96" as="geometry"/></mxCell><mxCell id="p1_a_cat" value="Danh mục LOẠI THIẾT BỊ&lt;br&gt;(ADM-06, DLG-23): điều hòa,&lt;br&gt;máy bơm, thang máy, đèn…" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1014" y="153" width="186" height="74" as="geometry"/></mxCell><mxCell id="p1_a_svc" value="DANH MỤC DỊCH VỤ cố định 2 cấp&lt;br&gt;(mở rộng IssueType): nhóm → loại.&lt;br&gt;Mỗi loại: mức khẩn cấp mặc định, CÓ&lt;br&gt;THUỘC DANH SÁCH KHẨN CẤP (→ F4),&lt;br&gt;bên chịu chi phí mặc định, áp dụng&lt;br&gt;văn phòng / chung cư, trường bắt buộc,&lt;br&gt;LOẠI THIẾT BỊ áp dụng, chuyên môn&lt;br&gt;Technician, thời gian chuẩn" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1228" y="122" width="230" height="136" as="geometry"/></mxCell><mxCell id="p1_dSvc" value="Đủ thuộc tính&lt;br&gt;bắt buộc, tên&lt;br&gt;không trùng?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1498" y="140" width="160" height="100" as="geometry"/></mxCell><mxCell id="p1_a_svcfix" value="Sửa lại mục danh mục&lt;br&gt;(nút Lưu bị khóa)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1492" y="421" width="170" height="58" as="geometry"/></mxCell><mxCell id="p1_a_tpl" value="Mẫu checklist theo LOẠI THIẾT&lt;br&gt;BỊ (G6): Officer chọn mẫu khi&lt;br&gt;lập kế hoạch định kỳ ở F2 rồi&lt;br&gt;chỉnh (R3 hiện để checklist&lt;br&gt;nằm trong từng kế hoạch, PM-02)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1688" y="142" width="210" height="96" as="geometry"/></mxCell><mxCell id="p1_op_std" value="OPEN A04: &quot;thời gian chuẩn&quot; của mỗi loại dịch vụ lấy từ đâu (Admin tự nhập, hay trung bình 3 tháng gần nhất)? Dùng để so với thời gian thao tác thực tế (G7) ở F6." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1682" y="398" width="220" height="104" as="geometry"/></mxCell><mxCell id="p1_c_p2" value="⇢ Trang 2&lt;br&gt;Đăng ký&lt;br&gt;thiết bị" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1952" y="157" width="130" height="66" as="geometry"/></mxCell><mxCell id="p1_o_view" value="Officer, Manager chỉ XEM cây địa điểm và danh sách thiết bị (AST-01, AST-02). ĐỀ XUẤT (chờ chốt S01 ở F6): Officer chỉ thấy tòa mình phụ trách." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="372" y="597" width="300" height="66" as="geometry"/></mxCell><mxCell id="p1_note_svc" value="Khi tạo case, hệ thống SAO CHÉP giá trị mặc định của loại dịch vụ vào case (mức khẩn cấp → SLA theo BR-08, bên chịu chi phí) → sửa danh mục sau này không làm đổi case cũ. Mục danh mục đã dùng chỉ được NGỪNG DÙNG (ẩn khỏi danh sách chọn), không xóa (R3 3.13.1)." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1362" y="588" width="470" height="84" as="geometry"/></mxCell><mxCell id="p1_s_save" value="Mọi thay đổi dữ liệu nền: lưu + ghi Audit Log giá trị cũ / mới (BR-16); áp dụng cho case MỚI." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1628" y="900" width="330" height="60" as="geometry"/></mxCell><mxCell id="p1_note_emerg" value="DANH SÁCH KHẨN CẤP (N26): mức khẩn cấp do LOẠI DỊCH VỤ (gắn loại thiết bị áp dụng) quyết định. Khách chọn loại dịch vụ nhưng không chọn mức; chọn sai thì Officer hạ ở F4 bước ④ / nâng ở F3 bước ④. Ví dụ: kẹt thang máy, rò gas, cháy / báo cháy, vỡ ống / ngập, mất điện cả tòa, mất nước cả tòa, an ninh (cửa từ hỏng mở toang)." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="712" y="777" width="440" height="86" as="geometry"/></mxCell><mxCell id="p1_op_svc" value="OPEN A03: danh mục dịch vụ dùng chung mọi tòa, hay mỗi tòa bật / tắt loại dịch vụ riêng (chung cư có &quot;bình nóng lạnh&quot;, văn phòng không)?" style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1482" y="772" width="230" height="96" as="geometry"/></mxCell><mxCell id="p1_c9" value="①" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="356" y="141" width="26" height="26" as="geometry"/></mxCell><mxCell id="p1_c10" value="②" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="558" y="134" width="26" height="26" as="geometry"/></mxCell><mxCell id="p1_c11" value="N23" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="752" y="135" width="31" height="18" as="geometry"/></mxCell><mxCell id="p1_c12" value="G1" style="rounded=1;arcSize=40;html=1;fillColor=#EDE4FA;strokeColor=#7B4FC9;fontColor=#4B2A8A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="722" y="135" width="26" height="18" as="geometry"/></mxCell><mxCell id="p1_c13" value="N23" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="384" width="31" height="18" as="geometry"/></mxCell><mxCell id="p1_c14" value="③" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="135" width="26" height="26" as="geometry"/></mxCell><mxCell id="p1_c15" value="N11" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="960" y="136" width="31" height="18" as="geometry"/></mxCell><mxCell id="p1_c16" value="N11" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="994" y="391" width="31" height="18" as="geometry"/></mxCell><mxCell id="p1_c17" value="④" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1002" y="141" width="26" height="26" as="geometry"/></mxCell><mxCell id="p1_c18" value="G6" style="rounded=1;arcSize=40;html=1;fillColor=#EDE4FA;strokeColor=#7B4FC9;fontColor=#4B2A8A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1172" y="142" width="26" height="18" as="geometry"/></mxCell><mxCell id="p1_c19" value="⑤" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1216" y="110" width="26" height="26" as="geometry"/></mxCell><mxCell id="p1_c20" value="N24" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1424" y="111" width="31" height="18" as="geometry"/></mxCell><mxCell id="p1_c21" value="N26" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1390" y="111" width="31" height="18" as="geometry"/></mxCell><mxCell id="p1_c22" value="N7" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1362" y="111" width="26" height="18" as="geometry"/></mxCell><mxCell id="p1_c23" value="G6" style="rounded=1;arcSize=40;html=1;fillColor=#EDE4FA;strokeColor=#7B4FC9;fontColor=#4B2A8A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1870" y="131" width="26" height="18" as="geometry"/></mxCell><mxCell id