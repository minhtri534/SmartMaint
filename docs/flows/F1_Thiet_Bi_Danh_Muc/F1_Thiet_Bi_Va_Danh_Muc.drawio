<diagram name="F1-2 Đăng ký thiết bị" id="p2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2322" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_c1" value="F1 · TRANG 2/5 — Đăng ký thiết bị, kích hoạt và gắn nhãn QR" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2282" height="30" as="geometry"/></mxCell><mxCell id="p2_c2" value="Chỉ đăng ký thiết bị THUỘC TÒA NHÀ (kể cả thiết bị tòa nhà cho thuê kèm hợp đồng). Thiết bị riêng của khách không vào hệ thống → sự cố của nó là &quot;ngoài phạm vi&quot; ở F3 (N23).&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · đỏ = MÂU THUẪN · xám viền đứt = việc NGOÀI hệ thống · ①–⑦ = đường chính · ↩ = quay lại · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy 12/10." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="2282" height="48" as="geometry"/></mxCell><mxCell id="p2_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="2302" height="500" as="geometry"/></mxCell><mxCell id="p2_c4" value="Admin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="500" as="geometry"/></mxCell><mxCell id="p2_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="600" width="2302" height="170" as="geometry"/></mxCell><mxCell id="p2_c6" value="Officer&lt;br&gt;phụ trách tòa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="600" width="130" height="170" as="geometry"/></mxCell><mxCell id="p2_c7" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="770" width="2302" height="160" as="geometry"/></mxCell><mxCell id="p2_c8" value="Kỹ thuật tòa nhà&lt;br&gt;(việc tay, ngoài&lt;br&gt;hệ thống)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="770" width="130" height="160" as="geometry"/></mxCell><mxCell id="p2_c9" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="930" width="2302" height="220" as="geometry"/></mxCell><mxCell id="p2_c10" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="930" width="130" height="220" as="geometry"/></mxCell><mxCell id="p2_p2_in" value="⇢ từ Trang 1" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="182" y="237" width="130" height="56" as="geometry"/></mxCell><mxCell id="p2_p2_start" value="BẮT ĐẦU (cách 2)&lt;br&gt;có thiết bị mới / thay&lt;br&gt;thế (từ Trang 4)" style="whiteSpace=wrap;html=1;fillColor=#1d2b4f;strokeColor=#1d2b4f;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;ellipse;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="168" y="374" width="160" height="62" as="geometry"/></mxCell><mxCell id="p2_dOwn" value="Thiết bị thuộc&lt;br&gt;tòa nhà? (không&lt;br&gt;phải của khách)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="380" y="213" width="164" height="104" as="geometry"/></mxCell><mxCell id="p2_e_notreg" value="KHÔNG đăng ký&lt;br&gt;(thiết bị của khách)" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=doubleEllipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="382" y="503" width="160" height="54" as="geometry"/></mxCell><mxCell id="p2_dHow" value="Thêm từng cái&lt;br&gt;hay nhập file?" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="600" y="219" width="156" height="92" as="geometry"/></mxCell><mxCell id="p2_a_man" value="Thêm thủ công (AST-04):&lt;br&gt;mã, tên, LOẠI THIẾT BỊ, tòa →&lt;br&gt;tầng → phòng, serial, ngày&lt;br&gt;hết bảo hành, ảnh" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="792" y="222" width="200" height="86" as="geometry"/></mxCell><mxCell id="p2_a_fixm" value="Sửa trường báo lỗi" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="812" y="138" width="160" height="44" as="geometry"/></mxCell><mxCell id="p2_dVal" value="Hợp lệ? (mã duy&lt;br&gt;nhất, phòng đang&lt;br&gt;dùng, serial&lt;br&gt;không trùng)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1024" y="212" width="168" height="106" as="geometry"/></mxCell><mxCell id="p2_a_imp" value="Nhập file (AST-05) bước 1–2:&lt;br&gt;tải file ≤ 5 MB, ≤ 1.000 dòng&lt;br&gt;→ hệ thống kiểm tra từng dòng" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="790" y="367" width="206" height="76" as="geometry"/></mxCell><mxCell id="p2_dRows" value="Có dòng lỗi?" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1034" y="363" width="146" height="84" as="geometry"/></mxCell><mxCell id="p2_dKeep" value="Nhập các dòng&lt;br&gt;tốt hay dừng&lt;br&gt;để sửa file?" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1028" y="480" width="160" height="100" as="geometry"/></mxCell><mxCell id="p2_a_fixf" value="Sửa file ngoài hệ&lt;br&gt;thống rồi tải lại" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="812" y="501" width="160" height="58" as="geometry"/></mxCell><mxCell id="p2_a_conf" value="Bước 3 Xác nhận → bước 4&lt;br&gt;Kết quả (chỉ thêm mới, không&lt;br&gt;ghi đè thiết bị đã có)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1224" y="369" width="196" height="72" as="geometry"/></mxCell><mxCell id="p2_s_create" value="Tạo thiết bị, sinh mã QR&lt;br&gt;(chỉ chứa đường dẫn + mã thiết&lt;br&gt;bị), ghi Audit Log (BR-16)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1438" y="978" width="200" height="74" as="geometry"/></mxCell><mxCell id="p2_st_active" value="Active" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1686" y="995" width="132" height="40" as="geometry"/></mxCell><mxCell id="p2_a_qr" value="In nhãn QR (AST-06): PDF / in&lt;br&gt;trực tiếp, tối đa 100 thiết bị&lt;br&gt;một lần — Admin hoặc Officer" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1650" y="647" width="206" height="76" as="geometry"/></mxCell><mxCell id="p2_x_stick" value="Dán nhãn lên thiết bị&lt;br&gt;(kỹ thuật tòa nhà)" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;dashed=1;dashPattern=8 4;fillColor=#F4F4F5;strokeColor=#71717A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1882" y="820" width="170" height="60" as="geometry"/></mxCell><mxCell id="p2_e_p2" value="KẾT THÚC&lt;br&gt;thiết bị sẵn sàng&lt;br&gt;để báo hỏng (Trang 3)" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=doubleEllipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2098" y="819" width="170" height="62" as="geometry"/></mxCell><mxCell id="p2_op_pm" value="OPEN A05: thiết bị thuộc loại BẮT BUỘC kiểm định / bảo trì định kỳ (thang máy, PCCC, máy phát) → hệ thống nhắc Officer lập kế hoạch F2 ngay khi tạo?" style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="2072" y="963" width="220" height="104" as="geometry"/></mxCell><mxCell id="p2_note_move" value="Đổi phòng của thiết bị đang có case mở: được, nhưng cảnh báo + case giữ địa điểm cũ trong Timeline (R3 3.15.1). Thiết bị mới vào ở trạng thái Active." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent=