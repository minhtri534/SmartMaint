<diagram name="F1-3 Vận hành" id="p3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2697" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3_c1" value="F1 · TRANG 3/5 — Thiết bị trong vận hành: quét QR và đổi trạng thái thiết bị" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2657" height="30" as="geometry"/></mxCell><mxCell id="p3_c2" value="Hai sự kiện độc lập (cách 1, cách 2). Trạng thái thiết bị chỉ để THÔNG TIN, không chặn khách báo hỏng (R3 3.15.2).&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · đỏ = MÂU THUẪN · xám viền đứt = việc NGOÀI hệ thống · ①–⑦ = đường chính · ↩ = quay lại · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy 12/10." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="2657" height="48" as="geometry"/></mxCell><mxCell id="p3_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="2677" height="170" as="geometry"/></mxCell><mxCell id="p3_c4" value="Khách hàng&lt;br&gt;(người thuê /&lt;br&gt;cư dân)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="170" as="geometry"/></mxCell><mxCell id="p3_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="270" width="2677" height="160" as="geometry"/></mxCell><mxCell id="p3_c6" value="Technician" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415