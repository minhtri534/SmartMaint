"1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_a_cat" target="p1_a_svc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_a_svc" target="p1_dSvc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_c38" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_dSvc" target="p1_a_svcfix"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_c39" value="↩ sửa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_a_svcfix" target="p1_a_svc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p1_c40" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_dSvc" target="p1_a_