iteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1692" y="172" width="140" height="56" as="geometry"/></mxCell><mxCell id="p2_st_comp" value="Completed" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1902" y="180" width="132" height="40" as="geometry"/></mxCell><mxCell id="p2_l_F2v" value="→ F3 Trang 4&lt;br&gt;nghiệm thu &amp;amp; đóng" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2102" y="172" width="160" height="56" as="geometry"/></mxCell><mxCell id="p2_t_vtime" value="⏱ Báo cáo RIÊNG thời gian pha bên&lt;br&gt;thứ 3 (từ lúc chuyển đến lúc Tiếp&lt;br&gt;tục) để không che chậm trễ (N16)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="602" y="899" width="230" height="72" as="geometry"/></mxCell><mxCell id="p2_s_after" value="BẮT ĐẦU (cách 2) — case&lt;br&gt;có &quot;đã thay thiết bị&quot; vừa&lt;br&gt;Closed: hệ thống nhắc&lt;br&gt;Officer (MỚI)" style="whiteSpace=wrap;html=1;fillColor=#1d2b4f;strokeColor=#1d2b4f;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;ellipse;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1240" y="428" width="186" height="84" as="geometry"/></mxCell><mxCell id="p2_dRepl" value="Đã THAY&lt;br&gt;thiết bị?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1488" y="428" width="140" height="84" as="geometry"/></mxCell><mxCell id="p2_l_F1" value="→ F1 Trang 4: Officer gửi đề&lt;br&gt;nghị; Admin đăng ký thiết bị&lt;br&gt;mới + thanh lý thiết bị cũ" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1688" y="435" width="210" height="70" as="geometry"/></mxCell><mxCell id="p2_e_keep" value="KẾT THÚC (chỉ sửa:&lt;br&gt;thiết bị giữ nguyên)" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=doubleEllipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1472" y="563" width="170" height="54" as="geometry"/></mxCell><mxCell id="p2_note_hist" value="Lịch sử thiết bị (AST-03) ghi &quot;bên thứ 3 / hãng bảo hành &amp;lt;tên&amp;gt; đã sửa / thay&quot; + nội dung ghi nhận. Thiết bị mới bắt đầu lịch sử mới, liên kết &quot;thay cho&quot; là OPEN A07 ở F1." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1358" y="898" width="440" height="74" as="geometry"/></mxCell><mxCell id="p2_c11" value="⑦" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="366" y="707" width="26" height="26" as="geometry"/></mxCell><mxCell id="p2_c12" value="⑧" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="588" y="157" width="26" height="26" as="geometry"/></mxCell><mxCell id="p2_c13" value="⑨" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1432" y="145" width="26" height="26" as="geometry"/