<diagram name="F5-1 Đánh giá &amp; quyết định" id="p1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="3103" pageHeight="1390" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_c1" value="F5 · TRANG 1/2 — Đánh giá và quyết định: sửa tiếp, chuyển bên thứ 3 sửa, hay THAY thiết bị" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="3063" height="30" as="geometry"/></mxCell><mxCell id="p1_c2" value="Ban tòa nhà quản lý bảo trì, không phải xưởng (N1, N3): không kho, không mua sắm, không lưu số tiền, không nút duyệt (N2, N22). Manager chỉ xem (BR-12) nên KHÔNG có bước &quot;Manager duyệt&quot; như bản tuần 4. Đã chốt 12/10: F5 là NGUỒN DUY NHẤT cho &quot;bên thứ 3 / bảo hành / báo giá / thay thiết bị&quot;; F3 Trang 3 chỉ phân loại phạm vi rồi → F5.&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · đỏ = MÂU THUẪN · xám viền đứt = việc NGOÀI hệ thống · ①–⑨ = đường chính · ⏱ = thời gian · ↩ = quay lại · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy 12/10." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="3063" height="48" as="geometry"/></mxCell><mxCell id="p1_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="3083" height="250" as="geometry"/></mxCell><mxCell id="p1_c4" value="Technician" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="250" as="geometry"/></mxCell><mxCell id="p1_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="350" width="3083" height="430" as="geometry"/></mxCell><mxCell id="p1_c6" value="Officer&lt;br&gt;phụ trách tòa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="350" width="130" height="430" as="geometry"/></mxCell><mxCell id="p1_c7" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="780" width="3083" height="170" as="geometry"/></mxCell><mxCell id="p1_c8" value="Bên thứ 3 /&lt;br&gt;hãng bảo hành&lt;br&gt;(ngoài hệ thống)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="780" width="130" height="170" as="geometry"/></mxCell><mxCell id="p1_c9" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="950" width="3083" height="170" as="geometry"/></mxCell><mxCell id="p1_c10" value="Đại diện hợp&lt;br&gt;đồng của khách&lt;br&gt;(ngoài hệ thống)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="950" width="130" height="170" as="geometry"/></mxCell><mxCell id="p1_c11" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="1120" width="3083" height="240" as="geometry"/></mxCell><mxCell id="p1_c12" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="1120" width="130" height="240" as="geometry"/></mxCell><mxCell id="p1_s1" value="BẮT ĐẦU (cách 1) — từ F3 ⑧:&lt;br&gt;Technician thấy vượt khả&lt;br&gt;năng / nên thay" style="whiteSpace=wrap;html=1;fillColor=#1d2b4f;strokeColor=#1d2b4f;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;ellipse;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="150" y="165" width="196" height="70" as="geometry"/></mxCell><mxCell id="p1_t_assess" value="Ghi ĐÁNH GIÁ KỸ THUẬT: tình&lt;br&gt;trạng, nguyên nhân, khuyến nghị&lt;br&gt;(sửa được / nên thay / cần chuyên&lt;br&gt;môn ngoài), ảnh — bắt buộc" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="370" y="157" width="206" height="86" as="geometry"/></mxCell><mxCell id="p1_t_hold" value="Tạm dừng (DLG-10)&lt;br&gt;lý do &quot;Chờ Officer&lt;br&gt;quyết định&quot;" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="618" y="165" width="160" height="70" as="geometry"/></mxCell><mxCell id="p1_st_hold" value="On Hold" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="826" y="180" width="132" height="40" as="geometry"/></mxCell><mxCell id="p1_op_hold" value="OPEN R02 (O12 của F3, N15): thầy nghiêng về giữ In Progress khi thay thiết bị; research dùng On Hold + lý do &quot;chờ bên thứ 3&quot;. Nhóm đề xuất On Hold → xin thầy chốt." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1028" y="152" width="260" height="96" as="geometry"/></mxCell><mxCell id="p1_s2" value="BẮT ĐẦU (cách 2) — chưa có case:&lt;br&gt;thẻ &quot;Hỏng thường xuyên&quot; (F1),&lt;br&gt;mở lại ≥ 3 lần, F4 ⑫ / F2 / F6&lt;br&gt;đề nghị xem xét" style="whiteSpace=wrap;html=1;fillColor=#1d2b4f;strokeColor=#1d2b4f;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;ellipse;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="148" y="535" width="200" height="80" as="geometry"/></mxCell><mxCell id="p1_o_new" value="Officer tạo case loại dịch vụ&lt;br&gt;&quot;Khảo sát thiết bị&quot; (thêm vào&lt;br&gt;danh mục F1; F6 không tính&lt;br&gt;vào KPI khách hàng)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="384" y="532" width="196" height="86" as="geometry"/></mxCell><mxCell id="p1_l_F2a" value="→ F3: giao Technician khảo&lt;br&gt;sát; xong quay lại cách 1" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="388" y="672" width="190" height="56" as="geometry"/></mxCell><mxCell id="p1_op_mgr" value="OPEN R01: Manager có cần thấy danh sách &quot;thiết bị đang chờ thay&quot; (ANA-03, chỉ xem) không?" style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="582" y="395" width="210" height="80" as="geometry"/></mxCell><mxCell id="p1_dScope" value="Lỗi do khách /&lt;br&gt;thiết bị của&lt;br&gt;khách?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="814" y="525" width="156" height="100" as="geometry"/></mxCell><mxCell id="p1_o_cancel" value="Hủy case (DLG-12): &quot;Ngoài&lt;br&gt;phạm vi tòa nhà&quot;, báo khách" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="798" y="669" width="190" height="62" as="geometry"/></mxCell><mxCell id="p1_st_can" value="Cancelled" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="622" y="680" width="132" height="40" as="geometry"/></mxCell><mxCell id="p1_s_info" value="Hiện BẢNG THÔNG TIN QUYẾT ĐỊNH&lt;br&gt;(không tính tiền): số lần sửa 12&lt;br&gt;tháng, số lần mở lại, tuổi thiết bị,&lt;br&gt;NGÀY HẾT BẢO HÀNH (đã có ở&lt;br&gt;AST-04), khuyến nghị Technician" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1004" y="1165" width="226" height="100" as="geometry"/></mxCell><mxCell id="p1_dWar" value="Còn bảo&lt;br&gt;hành?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1292" y="532" width="140" height="86" as="geometry"/></mxCell><mxCell id="p1_o_war" value="Gửi hãng bảo hành (ngoài hệ&lt;br&gt;thống); ghi nhận: đơn vị,&lt;br&gt;ngày gửi, ngày hẹn trả" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1264" y="665" width="196" height="70" as="geometry"/></mxCell><mxCell id="p1_dWok" value="Hãng nhận&lt;br&gt;bảo hành?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1528" y="658" width="140" height="84" as="geometry"/></mxCell><mxCell id="p1_c_pw" value="⇢ Trang 2&lt;br&gt;hãng thực hiện" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1528" y="835" width="140" height="60" as="geometry"/></mxCell><mxCell id="p1_dDec" value="Officer chọn&lt;br&gt;hướng xử lý?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1520" y="527" width="156" height="96" as="geometry"/></mxCell><mxCell id="p1_l_F2b" value="→ F3 bước ⑧: Technician&lt;br&gt;Tiếp tục (→ In Progress),&lt;br&gt;sửa trong khả năng" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1498" y="402" width="200" height="66" as="geometry"/></mxCell><mxCell id="p1_o_vendor" value="Ghi nhận chuyển bên thứ 3:&lt;br&gt;tên, liên hệ, việc (sửa / cung&lt;br&gt;cấp + lắp thiết bị mới), hạn&lt;br&gt;điều chỉnh + lý do" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1732" y="532" width="200" height="86" as="geometry"/></mxCell><mxCell id="p1_dNQ" value="Cần báo giá&lt;br&gt;theo lần?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1982" y="531" width="150" height="88" as="geometry"/></mxCell><mxCell id="p1_c_pnq" value="⇢ Trang 2 (hợp đồng&lt;br&gt;bảo trì trọn gói:&lt;br&gt;thang máy, PCCC…)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1972" y="400" width="170" height="70" as="geometry"/></mxCell><mxCell id="p1_x_v1" value="Khảo sát, gửi báo giá&lt;br&gt;cho ban tòa nhà" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;dashed=1;dashPattern=8 4;fillColor=#F4F4F5;strokeColor=#71717A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1970" y="835" width="176" height="60" as="geometry"/></mxCell><mxCell id="p1_dPay" value="Ai chịu chi phí?&lt;br&gt;(ghi ở F3 ④; chưa&lt;br&gt;có thì chọn ngay)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="2208" y="523" width="170" height="104" as="geometry"/></mxCell><mxCell id="p1_x_bm" value="Ban tòa nhà tự quyết: duyệt&lt;br&gt;nội bộ, hợp đồng, mua sắm&lt;br&gt;(ngoài hệ thống)" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;dashed=1;dashPattern=8 4;fillColor=#F4F4F5;strokeColor=#71717A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="2194" y="402" width="196" height="66" as="geometry"/></mxCell><mxCell id="p1_o_quote" value="Chuyển báo giá cho đại diện&lt;br&gt;hợp đồng; không lưu số tiền,&lt;br&gt;không có nút duyệt" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2194" y="665" width="196" height="70" as="geometry"/></mxCell><mxCell id="p1_x_k1" value="Đại diện xem báo giá, trả&lt;br&gt;lời ban tòa nhà (điện&lt;br&gt;thoại / email)" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;dashed=1;dashPattern=8 4;fillColor=#F4F4F5;strokeColor=#71717A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="2198" y="1002" width="190" height="66" as="geometry"/></mxCell><mxCell id="p1_o_record" value="Ghi nhận quyết định của bên&lt;br&gt;chịu chi phí + bằng chứng&lt;br&gt;(email / biên bản)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2440" y="539" width="196" height="72" as="geometry"/></mxCell><mxCell id="p1_dQ" value="Thực hiện?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="2692" y="533" width="140" height="84" as="geometry"/></mxCell><mxCell id="p1_o_cancel2" value="Hủy case (DLG-12) + lý&lt;br&gt;do, báo khách + Technician" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2668" y="404" width="190" height="62" as="geometry"/></mxCell><mxCell id="p1_st_can2" value="Cancelled" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2942" y="415" width="132" height="40" as="geometry"/></mxCell><mxCell id="p1_c_p2" value="⇢ Trang 2&lt;br&gt;thực hiện" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2942" y="547" width="130" height="56" as="geometry"/></mxCell><mxCell id="p1_note_crit" value="Tiêu chí &quot;sửa hay thay&quot; chỉ là THÔNG TIN hiển thị, Officer quyết và ghi lý do. Gợi ý: thay khi hết bảo hành VÀ (≥ 3 lần sửa / 12 tháng HOẶC Technician khuyến nghị thay HOẶC quá tuổi thọ của loại thiết bị). So sánh chi phí sửa / thay do ban tòa nhà làm ngoài hệ thống (N22)." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1102" y="1275" width="520" height="80" as="geometry"/></mxCell><mxCell id="p1_op_age" value="OPEN R03: &quot;tuổi thọ chuẩn&quot; theo loại thiết bị lưu ở danh mục F1 (Admin nhập)? Nếu không có thì bỏ tiêu chí tuổi thọ." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="2002" y="1275" width="230" height="80" as="geometry"/></mxCell><mxCell id="p1_op_who" value="OPEN R04 (O13 của F3): có thật cần nhánh &quot;khách chịu chi phí&quot;? Nếu có: lưu đại diện hợp đồng theo công ty thuê / căn hộ (F1 Trang 1)." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="2548" y="987" width="250" height="96" as="geometry"/></mxCell><mxCell id="p1_t_remind" value="⏱ Chưa có trả lời sau 3 ngày làm&lt;br&gt;việc → nhắc Officer" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1812" y="1005" width="230" height="60" as="geometry"/></mxCell><mxCell id="p1_c13" value="①" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="358" y="145" width="26" height="26" as="geometry"/></mxCell><mxCell id="p1_c14" value="N1" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="548" y="146" width="26" height="18" as="geometry"/></mxCell><mxCell id="p1_c15" value="G4" style="rounded=1;arcSize=40;html=1;fillColor=#EDE4FA;strokeColor=#7B4FC9;fontColor=#4B2A8A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="518" y="146" width="26" height="18" as="geometry"/></mxCell><mxCell id="p1_c16" value="②" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="606" y="153" wid