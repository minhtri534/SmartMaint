<mxfile host="app.diagrams.net" agent="SmartMaint-generator">
<diagram name="F3-1 Tiếp nhận &amp; duyệt" id="p1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="3052" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_c1" value="F3 · TRANG 1/5 — Tiếp nhận và duyệt (từ lúc khách báo đến Approved)" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="3012" height="30" as="geometry"/></mxCell><mxCell id="p1_c2" value="Bối cảnh: ban quản lý tòa nhà văn phòng cho thuê + chung cư (N17); khách hàng = người thuê / cư dân (N19). Chỉ Officer PHỤ TRÁCH TÒA nhận và xử lý (bỏ hàng chờ chung, N11). Loại dịch vụ thuộc danh sách khẩn cấp (danh sách chuẩn ở F1) sang F4 ngay khi tạo. Đồng hồ chỉ đếm GIỜ LÀM VIỆC của tòa (N8).&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · xám viền đứt = việc NGOÀI hệ thống · ①–⑫ = đường chính · ⏱ = thời gian · ↩ = quay lại · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy · thẻ AI = điểm AI hỗ trợ." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="3012" height="48" as="geometry"/></mxCell><mxCell id="p1_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="3032" height="250" as="geometry"/></mxCell><mxCell id="p1_c4" value="Khách hàng&lt;br&gt;(người thuê /&lt;br&gt;cư dân)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="250" as="geometry"/></mxCell><mxCell id="p1_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="350" width="3032" height="270" as="geometry"/></mxCell><mxCell id="p1_c6" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="350" width="130" height="270" as="geometry"/></mxCell><mxCell id="p1_c7" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="620" width="3032" height="450" as="geometry"/></mxCell><mxCell id="p1_c8" value="Officer&lt;br&gt;phụ trách tòa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="620" width="130" height="450" as="geometry"/></mxCell><mxCell id="p1_s1" value="BẮT ĐẦU&lt;br&gt;khách phát hiện sự cố" style="whiteSpace=wrap;html=1;fillColor=#1d2b4f;strokeColor=#1d2b4f;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;ellipse;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="168" y="157" width="160" height="56" as="geometry"/></mxCell><mxCell id="p1_c1" value="Gửi yêu cầu (EMP-02): quét QR /&lt;br&gt;chọn vị trí, LOẠI DỊCH VỤ (danh&lt;br&gt;mục F1), mô tả, ảnh (bắt buộc&lt;br&gt;theo loại dịch vụ)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="370" y="142" width="206" height="86" as="geometry"/></mxCell><mxCell id="p1_ai_req" value="AI · gợi ý loại dịch vụ + mức&lt;br&gt;khẩn cấp từ mô tả; nhắc thiếu&lt;br&gt;thông tin TRƯỚC khi gửi (O05);&lt;br&gt;khách chọn, Officer chốt" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=14;dashed=1;dashPattern=4 3;fillColor=#E8F0FE;strokeColor=#1A56DB;" vertex="1" parent="1"><mxGeometry x="618" y="144" width="200" height="82" as="geometry"/></mxCell><mxCell id="p1_note_emp" value="Khách tự thao tác khi còn Pending: Sửa (EMP-04) → vẫn Pending · Hủy (DLG-12) → Cancelled. Officer cũng hủy được (lý do ≥ 10 ký tự)." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="948" y="152" width="400" height="66" as="geometry"/></mxCell><mxCell id="p1_c_resend" value="Khách bấm &quot;GỬI LẠI&quot;: tạo case&lt;br&gt;MỚI điền sẵn nội dung cũ&lt;br&gt;⇢ bước ①" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=40;dashed=1;dashPattern=2 3;" vertex="1" parent="1"><mxGeometry x="1898" y="267" width="200" height="66" as="geometry"/></mxCell><mxCell id="p1_dEmer" value="Loại dịch vụ&lt;br&gt;thuộc DANH SÁCH&lt;br&gt;KHẨN CẤP (F1)?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="388" y="393" width="170" height="104" as="geometry"/></mxCell><mxCell id="p1_l_F4a" value="→ F4 ngay khi&lt;br&gt;tạo (bỏ Pending)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="172" y="417" width="150" height="56" as="geometry"/></mxCell><mxCell id="p1_s3" value="BẮT ĐẦU (cách 3) — từ F2:&lt;br&gt;lệnh định kỳ có mục Không&lt;br&gt;đạt, Technician tick (BR-07)" style="whiteSpace=wrap;html=1;fillColor=#1d2b4f;strokeColor=#1d2b4f;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;ellipse;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="372" y="518" width="200" height="74" as="geometry"/></mxCell><mxCell id="p1_op01" value="OPEN O01: case tạo từ F2 không có khách — ai nhận thông báo, ai đánh giá? Đề xuất: người yêu cầu = Officer phụ trách tòa; bỏ đánh giá." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="142" y="503" width="170" height="104" as="geometry"/></mxCell><mxCell id="p1_s_create" value="Tạo case: SAO CHÉP mặc định&lt;br&gt;của loại dịch vụ (mức, bên chịu&lt;br&gt;chi phí); báo Officer PHỤ TRÁCH&lt;br&gt;TÒA (gửi ngoài giờ: báo khách&lt;br&gt;&quot;xử lý trong giờ làm việc&quot;)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="612" y="395" width="210" height="100" as="geometry"/></mxCell><mxCell id="p1_st_pend" value="Pending" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="876" y="425" width="132" height="40" as="geometry"/></mxCell><mxCell id="p1_t_first" value="⏱ Đếm &quot;phản hồi đầu&quot; theo GIỜ&lt;br&gt;LÀM VIỆC của tòa (BR-08), dừng&lt;br&gt;ở quyết định đầu của Officer" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="842" y="519" width="200" height="72" as="geometry"/></mxCell><mxCell id="p1_op04" value="OPEN O04: văn phòng và chung cư dùng chung một lịch làm việc? Đề xuất: mỗi tòa một lịch (ADM-07 theo tòa); ngoài giờ chỉ F4." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1252" y="509" width="210" height="92" as="geometry"/></mxCell><mxCell id="p1_t_appr" value="⏱ Approved: bắt đầu đếm hạn xử lý&lt;br&gt;theo mức. HẠN CÓ HIỆU LỰC = hạn&lt;br&gt;dài hơn giữa hạn SLA gốc và hạn&lt;br&gt;Officer đã sửa (N16)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="2342" y="402" width="230" height="86" as="geometry"/></mxCell><mxCell id="p1_s2" value="BẮT ĐẦU (cách 2)&lt;br&gt;khách gọi điện /&lt;br&gt;gặp trực tiếp" style="whiteSpace=wrap;html=1;fillColor=#1d2b4f;strokeColor=#1d2b4f;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;ellipse;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="172" y="812" width="150" height="66" as="geometry"/></mxCell><mxCell id="p1_o_alt" value="Officer nhập thay (OFF-05);&lt;br&gt;tick &quot;Duyệt ngay&quot; thì BẮT&lt;br&gt;BUỘC chọn bên chịu chi phí" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="370" y="809" width="184" height="72" as="geometry"/></mxCell><mxCell id="p1_dAlt" value="Duyệt&lt;br&gt;ngay?" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="618" y="803" width="120" height="84" as="geometry"/></mxCell><mxCell id="p1_g_alt" value="↩ Tạo case, báo khách, vào&lt;br&gt;thẳng Approved (sau bước ④)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=40;dashed=1;dashPattern=2 3;" vertex="1" parent="1"><mxGeometry x="580" y="955" width="196" height="60" as="geometry"/></mxCell><mxCell id="p1_op02" value="OPEN O02: Officer chính / dự phòng do Admin gán; ai bật &quot;vắng&quot;; cả hai vắng; bỏ claim; đổi người phụ trách thì case mở chuyển cho người mới." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="828" y="653" width="210" height="104" as="geometry"/></mxCell><mxCell id="p1_o_open" value="Nhận thông báo, mở case —&lt;br&gt;chỉ case của TÒA MÌNH&lt;br&gt;(bỏ hàng chờ chung)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1026" y="809" width="184" height="72" as="geometry"/></mxCell><mxCell id="p1_ai_off" value="AI · gợi ý case có thể trùng&lt;br&gt;+ khu chung hay khu riêng;&lt;br&gt;Officer quyết định" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=14;dashed=1;dashPattern=4 3;fillColor=#E8F0FE;strokeColor=#1A56DB;" vertex="1" parent="1"><mxGeometry x="1268" y="668" width="190" height="74" as="geometry"/></mxCell><mxCell id="p1_o_view" value="Xem chi tiết + LỊCH SỬ&lt;br&gt;thiết bị (AST-03)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1278" y="815" width="170" height="60" as="geometry"/></mxCell><mxCell id="p1_dDup" value="Trùng sự cố&lt;br&gt;đang xử lý?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1528" y="801" width="140" height="88" as="geometry"/></mxCell><mxCell id="p1_o_merge" value="GỘP vào case chính: case con&lt;br&gt;khóa, không tính KPI, vị trí thêm&lt;br&gt;vào case chính; gộp case khẩn&lt;br&gt;cấp → case chính lên mức cao&lt;br&gt;nhất trong nhóm" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1494" y="937" width="206" height="96" as="geometry"/></mxCell><mxCell id="p1_e_merge" value="KẾT THÚC&lt;br&gt;(case con theo&lt;br&gt;case chính)" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=doubleEllipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1262" y="954" width="140" height="62" as="geometry"/></mxCell><mxCell id="p1_op03" value="OPEN O03: case chính bị hủy / từ chối khi còn case con? Case con có đánh giá riêng? Đề xuất: chặn khách tự hủy case chính; dùng cờ liên kết (giữ 11 trạng thái)." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1742" y="933" width="220" height="104" as="geometry"/></mxCell><mxCell id="p1_dInfo" value="Đủ thông&lt;br&gt;tin?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1762" y="803" width="120" height="84" as="geometry"/></mxCell><mxCell id="p1_op05" value="OPEN O05: bỏ Need more info thì giảm từ chối thế nào? Đề xuất: trường bắt buộc theo loại dịch vụ + AI nhắc; thống kê riêng lý do &quot;Thiếu thông tin&quot;." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1498" y="653" width="200" height="104" as="geometry"/></mxCell><mxCell id="p1_o_rejI" value="Từ chối (DLG-02), lý do&lt;br&gt;&quot;Thiếu thông tin&quot; (thay&lt;br&gt;Need more info)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1758" y="670" width="170" height="70" as="geometry"/></mxCell><mxCell id="p1_st_rej" value="Rejected" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeomet