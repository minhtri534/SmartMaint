<diagram name="F3-2 Giao việc &amp; sửa chữa" id="p2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="3187" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_c1" value="F3 · TRANG 2/5 — Giao việc, chẩn đoán và sửa chữa (Approved → Completed)" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="3147" height="30" as="geometry"/></mxCell><mxCell id="p2_c2" value="Technician chỉ sửa sự cố thông thường (N1, N25); vượt khả năng / cần thay / lỗi do khách → On Hold &quot;chờ Officer quyết định&quot; → Trang 3 → F5. Không quản lý kho: linh kiện ghi tay, mua ngoài hệ thống (N2).&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · xám viền đứt = việc NGOÀI hệ thống · ①–⑫ = đường chính · ⏱ = thời gian · ↩ = quay lại · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy · thẻ AI = điểm AI hỗ trợ." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="3147" height="48" as="geometry"/></mxCell><mxCell id="p2_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="3167" height="330" as="geometry"/></mxCell><mxCell id="p2_c4" value="Officer&lt;br&gt;phụ trách tòa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="330" as="geometry"/></mxCell><mxCell id="p2_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="430" width="3167" height="520" as="geometry"/></mxCell><mxCell id="p2_c6" value="Technician" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="430" width="130" height="520" as="geometry"/></mxCell><mxCell id="p2_c7" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="950" width="3167" height="170" as="geometry"/></mxCell><mxCell id="p2_c8" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="950" width="130" height="170" as="geometry"/></mxCell><mxCell id="p2_c9" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="1120" width="3167" height="150" as="geometry"/></mxCell><mxCell id="p2_c10" value="Facility&lt;br&gt;Manager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="1120" width="130" height="150" as="geometry"/></mxCell><mxCell id="p2_c_in2" value="⇢ từ Trang 1" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="182" y="297" width="130" height="56" as="geometry"/></mxCell><mxCell id="p2_st_appr2" value="Approved" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="396" y="305" width="132" height="40" as="geometry"/></mxCell><mxCell id="p2_o_assign" value="Giao Technician (DLG-04):&lt;br&gt;đúng chuyên môn → ít việc&lt;br&gt;nhất; hạn gợi ý theo SLA" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="592" y="289" width="190" height="72" as="geometry"/></mxCell><mxCell id="p2_dTech" value="Có người&lt;br&gt;phù hợp?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="848" y="282" width="130" height="86" as="geometry"/></mxCell><mxCell id="p2_o_resched" value="DỜI LỊCH: hạn mới + lý do;&lt;br&gt;vẫn Approved, đồng hồ&lt;br&gt;vẫn chạy" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="820" y="152" width="184" height="66" as="geometry"/></mxCell><mxCell id="p2_st_asg" value="Assigned" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1062" y="305" width="132" height="40" as="geometry"/></mxCell><mxCell id="p2_note_off" value="Officer bất cứ lúc nào: GIAO LẠI (DLG-05: lý do, KHÔNG reset SLA, người mới phải Nhận) · HỦY (DLG-12, báo khách + Technician) · ĐỔI MỨC kèm lý do (lên Khẩn cấp → F4) · DỜI HẠN (chỉ trước khi quá hạn)." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1318" y="146" width="560" height="78" as="geometry"/></mxCell><mxCell id="p2_op08" value="OPEN O08: sự cố nặng lên giữa chừng? Đề xuất: Officer đổi mức kèm lý do, hạn tính lại theo mức mới; lên Khẩn cấp → F4." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1442" y="282" width="230" height="86" as="geometry"/></mxCell><mxCell id="p2_op09" value="OPEN O09: &quot;hạn dài hơn&quot; bị lạm dụng? Đề xuất: chỉ dời TRƯỚC khi quá hạn, lý do chọn từ danh sách; F6 hiện cả tỷ lệ theo SLA gốc và số lần dời." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1888" y="279" width="240" height="92" as="geometry"/></mxCell><mxCell id="p2_dAcc" value="Nhận việc?&lt;br&gt;(Assigned hoặc&lt;br&gt;Reopened · DLG-09)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1044" y="480" width="166" height="100" as="geometry"/></mxCell><mxCell id="p2_g_rej" value="↩ Từ chối + lý do (BR-13; kể cả&lt;br&gt;&quot;sai chuyên môn&quot;): về Approved,&lt;br&gt;báo Officer phụ trách → ⑤" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=40;dashed=1;dashPattern=2 3;" vertex="1" parent="1"><mxGeometry x="1022" y="640" width="210" height="70" as="geometry"/></mxCell><mxCell id="p2_op06" value="OPEN O06: Technician im lặng? Đề xuất: Assigned quá hạn phản hồi đầu → nhắc Technician + báo Officer." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="768" y="484" width="190" height="92" as="geometry"/></mxCell><mxCell id="p2_st_acc" value="Accepted" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1286" y="510" width="132" height="40" as="geometry"/></mxCell><mxCell id="p2_t_start" value="Bắt đầu tại&lt;br&gt;hiện trường" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1498" y="502" width="140" height="56" as="geometry"/></mxCell><mxCell id="p2_st_inp" value="In Progress" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1716" y="510" width="132" height="40" as="geometry"/></mxCell><mxCell id="p2_t_diag" value="Chẩn đoán + xem LỊCH SỬ&lt;br&gt;THIẾT BỊ (tab trong TEC-03;&lt;br&gt;sửa mâu thuẫn R3 cũ)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1912" y="494" width="190" height="72" as="geometry"/></mxCell><mxCell id="p2_ai_tec" value="AI · gợi ý hướng xử lý theo&lt;br&gt;loại dịch vụ + lịch sử thiết&lt;br&gt;bị; Technician quyết định" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=14;dashed=1;dashPattern=4 3;fillColor=#E8F0FE;strokeColor=#1A56DB;" vertex="1" parent="1"><mxGeometry x="1882" y="638" width="190" height="74" as="geometry"/></mxCell><mxCell id="p2_dHow" value="Trong khả&lt;br&gt;năng, sửa&lt;br&gt;ngay được?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="2162" y="482" width="140" height="96" as="geometry"/></mxCell><mxCell id="p2_t_fix" value="GHI NHẬN SỬA CHỮA: NỘI DUNG&lt;br&gt;ĐÃ LÀM (bắt buộc), nguyên nhân&lt;br&gt;(RootCause), linh kiện ghi tay,&lt;br&gt;giờ công, ảnh trước / sau" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2362" y="487" width="210" height="86" as="geometry"/></mxCell><mxCell id="p2_t_comp" value="Báo hoàn&lt;br&gt;thành (DLG-11)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2622" y="500" width="140" height="60" as="geometry"/></mxCell><mxCell id="p2_st_comp" value="Completed" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2832" y="510" width="132" height="40" as="geometry"/></mxCell><mxCell id="p2_c_p4" value="⇢ Trang 4&lt;br&gt;nghiệm thu" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3028" y="502" width="130" height="56" as="geometry"/></mxCell><mxCell id="p2_dWhy" value="Vì sao&lt;br&gt;chưa sửa?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="2168" y="631" width="130" height="88" as="geometry"/></mxCell><mxCell id="p2_t_hold" value="Tạm dừng (DLG-10): LÝ DO&lt;br&gt;có cấu trúc (chờ linh kiện /&lt;br&gt;chờ khách cho vào) + ngày dự&lt;br&gt;kiến tiếp tục; chờ khách → hẹn" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2368" y="633" width="200" height="84" as="geometry"/></mxCell><mxCell id="p2_st_hold" value="On Hold" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2626" y="655" width="132" height="40" as="geometry"/></mxCell><mxCell id="p2_g_res" value="↩ Tiếp tục (Resume)&lt;br&gt;→ In Progress" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=40;dashed=1;dashPattern=2 3;" vertex="1" parent="1"><mxGeometry x="2818" y="647" width="160" height="56" as="geometry"/></mxCell><mxCell id="p2_op07" value="OPEN O07: duyệt đề xuất On Hold? Lý do có cấu trúc; SLA CHỈ DỪNG khi chờ phía khách, lý do khác SLA vẫn chạy (khác BR-08 hiện tại)." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="2762" y="777" width="230" height="96" as="geometry"/></mxCell><mxCell id="p2_t_assess" value="Vượt khả năng / cần thay / lỗi&lt;br&gt;do khách: ghi ĐÁNH GIÁ KỸ&lt;br&gt;THUẬT + ảnh; Tạm dừng lý do&lt;br&gt;&quot;chờ Officer quyết định&quot;" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2128" y="783" width="210" height="84" as="geometry"/></mxCell><mxCell id="p2_st_hold2" value="On Hold" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2402" y="805" width="132" height="40" as="geometry"/></mxCell><mxCell id="p2_c_p3" value="⇢ Trang 3&lt;br&gt;phân loại lại" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2608" y="797" width="130" height="56" as="geometry"/></mxCell><mxCell id="p2_note_notif" value="Thông báo chỉ gửi Officer PHỤ TRÁCH TÒA (thay cho &quot;tất cả Officer&quot; trong R3 5.4.2): Technician từ chối, tạm dừng, hoàn thành. Khách được báo khi giao việc, tạm dừng chờ khách, hoàn thành." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="182" y="998" width="560" height="74" as="geometry"/></mxCell><mxCell id="p2_sys_sla" value="Theo dõi SLA nền theo HẠN CÓ HIỆU&lt;br&gt;LỰC: gần hạn → báo Officer phụ&lt;br&gt;trách; quá hạn → cờ đỏ, báo&lt;br&gt;Officer + Manager" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1462" y="992" width="230" height="86" as="geometry"/></mxCell><mxCell id="p2_m1" value="Nhận cảnh báo quá hạn; xem số&lt;br&gt;lần Technician từ chối + lý do&lt;br&gt;(ANA-02, N10) — chỉ xem (BR-12)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1470" y="1159" width="216" height="72" as="geometry"/></mxCell><mxCell id="p2_e_m" value="KẾT THÚC&lt;br&gt;(chỉ giám sát)" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=doubleEllipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1752" y="1169" width="140" height="52" as="geometry"/></mxCell><mxCell id="p2_op10" value="OPEN O10: Manager nhận cảnh báo để làm gì? Đề xuất: giữ BR-12; giám sát qua KPI, can thiệp NGOÀI hệ thống." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="2068" y="1155" width="250" height="80" as="geometry"/></mxCell><mxCell id="p2_c11" value="⑤" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="277" width="26" height="26" as="geometry"/></mxCell><mxCell id="p2_c12" value="N9" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="9