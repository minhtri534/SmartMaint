<diagram name="F3-3 Phân loại lại → F5" id="p3"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1972" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3_c1" value="F3 · TRANG 3/5 — Officer phân loại lại sau khi Technician khảo sát (On Hold &quot;chờ Officer quyết định&quot;)" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1932" height="30" as="geometry"/></mxCell><mxCell id="p3_c2" value="Đã chốt 12/10: F5 là NGUỒN DUY NHẤT cho bảo hành, bên thứ 3, báo giá, thay thiết bị (N1, N3, N22). Trang này chỉ giữ phần thuộc F3: phân loại lại phạm vi (N23) và quyết định có chuyển F5 hay không.&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · xám viền đứt = việc NGOÀI hệ thống · ①–⑫ = đường chính · ⏱ = thời gian · ↩ = quay lại · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy · thẻ AI = điểm AI hỗ trợ." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1932" height="48" as="geometry"/></mxCell><mxCell id="p3_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="1952" height="170" as="geometry"/></mxCell><mxCell id="p3_c4" value="Technician" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="170" as="geometry"/></mxCell><mxCell id="p3_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="270" width="1952" height="300" as="geometry"/></mxCell><mxCell id="p3_c6" value="Officer&lt;br&gt;phụ trách tòa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="270" width="130" height="300" as="geometry"/></mxCell><mxCell id="p3_c7" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="570" width="1952" height="160" as="geometry"/></mxCell><mxCell id="p3_c8" value="Khách hàng&lt;br&gt;(người thuê /&lt;br&gt;cư dân)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="570" width="130" height="160" as="geometry"/></mxCell><mxCell id="p3_c_in3" value="⇢ từ Trang 2&lt;br&gt;(On Hold)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="182" y="330" width="130" height="60" as="geometry"/></mxCell><mxCell id="p3_st_hold3" value="On Hold" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="396" y="340" width="132" height="40" as="geometry"/></mxCell><mxCell id="p3_o_read" value="Đọc đánh giá kỹ thuật + ảnh;&lt;br&gt;cần thêm thông tin thì hỏi&lt;br&gt;Technician qua bình luận" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="592" y="324" width="190" height="72" as="geometry"/></mxCell><mxCell id="p3_dScope2" value="Phân loại lại&lt;br&gt;phạm vi?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="858" y="314" width="150" height="92" as="geometry"/></mxCell><mxCell id="p3_g_cont" value="↩ Technician Tiếp tục → In&lt;br&gt;Progress, sửa trong khả&lt;br&gt;năng (Trang 2 ⑧)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=40;dashed=1;dashPattern=2 3;" vertex="1" parent="1"><mxGeometry x="834" y="152" width="196" height="66" as="geometry"/></mxCell><mxCell id="p3_o_cancel" value="Hủy (DLG-12), lý do &quot;Ngoài&lt;br&gt;phạm vi tòa nhà&quot;; ghi bên&lt;br&gt;chịu chi phí = khách; báo khách" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="832" y="449" width="200" height="72" as="geometry"/></mxCell><mxCell id="p3_st_can" value="Cancelled" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1122" y="465" width="132" height="40" as="geometry"/></mxCell><mxCell id="p3_l_F5" value="→ F5 (nguồn duy nhất): bảo hành,&lt;br&gt;bên thứ 3, báo giá, thay thiết bị;&lt;br&gt;xong quay về F3 Trang 4" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1268" y="325" width="230" height="70" as="geometry"/></mxCell><mxCell id="p3_x_cus" value="Khách được báo kết quả phân loại: hủy vì ngoài phạm vi (kèm lý do), hoặc đang chuyển bên thứ 3 (F5). Báo giá chỉ gửi ĐẠI DIỆN HỢP ĐỒNG, xử lý ở F5." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="732" y="615" width="440" height="70" as="geometry"/></mxCell><mxCell id="p3_op11" value="OPEN O11–O13 (CHUYỂN SANG F5): O11 danh bạ bên thứ 3 do Admin quản lý? · O12 chờ bên thứ 3: On Hold hay In Progress (= R02 của F5) · O13 nhánh &quot;khách chịu chi phí&quot;, báo giá gửi ai (= R04 của F5)." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1642" y="308" width="300" height="104" as="geometry"/></mxCell><mxCell id="p3_c9" value="N23" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="974" y="303" width="31" height="18" as="geometry"/></mxCell><mxCell id="p3_c10" value="N23" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="438" width="31" height="18" as="geometry"/></mxCell><mxCell id="p3_c11" value="N1" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1470" y="314" width="26" height="18" as="geometry"/></mxCell><mxCell id="p3_c12" value="N3" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1440" y="314" width="26" height="18" as="geometry"/></mxCell><mxCell id="p3_c13" value="N3" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1914" y="297" width="26" height="18" as="geometry"/></mxCell><mxCell id="p3_c14" value="N15" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1880" y="297" width="31" height="18" as="geometry"/></mxCell><mxCell id="p3_c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_c_in3" target="p3_st_hold3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3_c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_st_hold3" target="p3_o_read"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3_c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_o_read" target="p3_dScope2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3_c18" value="Trong khả năng" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_dScope2" target="p3_g_cont"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3_c19" value="Ngoài phạm vi&lt;br&gt;(lỗi do khách /&lt;br&gt;thiết bị của khách)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_dScope2" target="p3_o_cancel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3_c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_o_cancel" target="p3_st_can"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3_c21" value="Trong phạm vi, vượt&lt;br&gt;khả năng / cần thay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_dScope2" target="p3_l_F5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3_c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;dashed=1;dashPattern=5 4;endArrow=none;strokeColor=#8A94A6;strokeWidth=1.4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_x_cus" target="p3_o_cancel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p3_c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=6;html=1;endArrow=block;endFill=1;strokeWidth=1.8;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#3a3a3a;dashed=1;dashPattern=5 4;endArrow=none;strokeColor=#8A94A6;strokeWidth=1.4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_op11" target="p3_l_F5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram>
<diagram name="F3-4 Nghiệm thu &amp; đóng" id="p4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2348" pageHeight="990" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4_c1" value="F3 · TRANG 4/5 — Nghiệm thu, đóng và sau khi đóng (Completed → Closed / Reopened)" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2308" height="30" as="geometry"/></mxCell><mxCell id="p4_c2" value="Technician báo xong (Completed) chưa phải là đóng: chỉ Officer đóng hoặc mở lại (BR-13). Case đã THAY thiết bị: sau khi đóng → F5 Trang 2 (cách 2) → F1 Trang 4.&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · xám viền đứt = việc NGOÀI hệ thống · ①–⑫ = đường chính · ⏱ = thời gian · ↩ = quay lại · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy · thẻ AI = điểm AI hỗ trợ." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="2308" height="48" as="geometry"/></mxCell><mxCell id="p4_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="2328" height="300" as="geometry"/></mxCell><mxCell id="p4_c4" value="Khách hàng&lt;br&gt;(người thuê /&lt;br&gt;cư dân)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="300" as="geometry"/></mxCell><mxCell id="p4_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="400" width="2328" height="330" as="geometry"/></mxCell><mxCell id="p4_c6" value="Officer&lt;br&gt;phụ trách tòa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="400" width="130" height="330" as="geometry"/></mxCell><mxCell id="p4_c7" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="730" width="2328" height="230" as="geometry"/></mxCell><mxCell id="p4_c8" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="730" width="130" height="230" as="geometry"/></mxCell><mxCell id="p4_c_in4" value="⇢ từ Trang 2" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="182" y="577" width="130" height="56" as="geometry"/></mxCell><mxCell id="p4_st_comp4" value="Completed" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="396" y="585" width="132" height="40" as="geometry"/></mxCell><mxCell id="p4_o_ver" value="Kiểm tra kết quả (OFF-04):&lt;br&gt;nội dung đã làm, ảnh&lt;br&gt;trước / sau" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="598" y="570" width="180" height="70" as="geometry"/></mxCell><mxCell id="p4_dV" value="Đạt?" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="858" y="567" width="110" height="76" as="geometry"/></mxCell><mxCell id="p4_o_close" value="Xác nhận &amp;amp; đóng (DLG-06);&lt;br&gt;báo khách + KHÁCH CỦA CASE&lt;br&gt;ĐÃ GỘP; trả thiết bị về Active" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1038" y="569" width="200" height="72" as="geometry"/></mxCell><mxCell id="p4_st_closed" value="Closed" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1296" y="585" width="132" height="40" as="geometry"/></mxCell><mxCell id="p4_o_reopen" value="Mở lại (DLG-07): lý do&lt;br&gt;+ hạn mới; đếm số lần" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="824" y="450" width="176" height="60" as="geometry"/></mxCell><mxCell id="p4_st_reop" value="Reopened" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="612" y="460" width="132" height="40" as="geometry"/></mxCell><mxCell id="p4_c_back" value="⇢ Trang 2 ⑥&lt;br&gt;Technician nhận lại&lt;br&gt;(mặc định cùng&lt;br&gt;người, BR-04)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="368" y="442" width="150" height="76" as="geometry"/></mxCell><mxCell id="p4_t14" value="⏱ OPEN O14: hạn cho bước nghiệm&lt;br&gt;thu? Đề xuất: Completed quá 1 ngày&lt;br&gt;làm việc chưa kiểm tra → cảnh báo" style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=12;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="358" y="660" width="210" height="70" as="geometry"/></mxCell><mxCell id="p4_op16" value="OPEN O16: nghiệm thu chỉ bằng ảnh có đủ? Đề xuất: ảnh trước / sau bắt buộc + 7 ngày khách báo lại." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="612" y="655" width="210" height="80" as="geometry"/></mxCell><mxCell id="p4_note_off4" value="Technician không tự đóng (BR-13). Ở Completed, Officer chỉ Đóng hoặc Mở lại." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="998" y="669" width="320" height="52" as="geometry"/></mxCell><mxCell id="p4_dV2" value="Chấp nhận&lt;br&gt;mở lại?" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1728" y="437" width="130" height="86" as="geometry"/></mxCell><mxCell id="p4_o_decl" value="Từ chối yêu cầu (DLG-08)&lt;br&gt;+ lý do; case vẫn Closed" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1938" y="450" width="180" height="60" as="geometry"/></mxCell><mxCell id="p4_st_end1" value="Closed" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=50;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2186" y="460" width="132" height="40" as="geometry"/></mxCell><mxCell id="p4_op15" value="OPEN O15: &quot;SLA met&quot; tính theo lần Completed đầu hay cuối? Đề xuất: lần đầu; mở lại có KPI riêng." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="558" y="277" width="200" height="86" as="geometry"/></mxCell><mxCell id="p4_op17" value="OPEN O17: mở lại ≥ 3 lần → bắt buộc xem xét chuyển bên thứ 3 / thay thiết bị (→ F5)?" style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="812" y="280" width="200" height="80" as="geometry"/></mxCell><mxCell id="p4_dE" value="Sự cố đã&lt;br&gt;hết hẳn?" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1472" y="277" width="130" height="86" as="geometry"/></mxCell><mxCell id="p4_e_rate" value="Đánh giá 1–5 sao (DLG-14),&lt;br&gt;tùy chọn, 1 lần" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1880" y="290" width="176" height="60" as="geometry"/></mxCell><mxCell id="p4_end2" value="KẾT THÚC&lt;br&gt;(Closed)" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=doubleEllipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2128" y="295" width="130" height="50" as="geometry"/></mxCell><mxCell id="p4_dE7" value="≤ 7 ngày &amp;amp; chưa&lt;br&gt;báo lần nào?&lt;br&gt;(BR-03)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1458" y="137" width="160" height="96" as="geometry"/></mxCell><mxCell id="p4_e_nf" value="Báo &quot;Chưa sửa&lt;br&gt;xong&quot; (DLG-13)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1718" y="156" width="150" height="58" as="geometry"/></mxCell><mxCell id="p4_g_new" value="Gửi yêu cầu MỚI&lt;br&gt;⇢ Trang 1 ①" style="whiteSpace=wrap;ht