<diagram name="F6-1 Thu thập &amp; tính chỉ số" id="p1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2727" pageHeight="970" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_c1" value="F6 · TRANG 1/2 — Thu thập dữ liệu và tính chỉ số (hệ thống tự chạy nền)" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2687" height="30" as="geometry"/></mxCell><mxCell id="p1_c2" value="Mọi chỉ số tính từ Timeline / Audit Log (BR-16), một định nghĩa dùng chung cho MGR-01, OFF-01 và ANA-01 (R3 3.10). F3 đếm theo giờ hành chính; F4 khẩn cấp đếm 24/7 (N8).&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · đỏ = MÂU THUẪN · xám viền đứt = việc NGOÀI hệ thống · ①–⑨ = đường chính · ⏱ = thời gian · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy 12/10." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="2687" height="48" as="geometry"/></mxCell><mxCell id="p1_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="2707" height="470" as="geometry"/></mxCell><mxCell id="p1_c4" value="Hệ thống" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="470" as="geometry"/></mxCell><mxCell id="p1_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="570" width="2707" height="200" as="geometry"/></mxCell><mxCell id="p1_c6" value="Officer&lt;br&gt;phụ trách tòa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="570" width="130" height="200" as="geometry"/></mxCell><mxCell id="p1_c7" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="770" width="2707" height="170" as="geometry"/></mxCell><mxCell id="p1_c8" value="Facility&lt;br&gt;Manager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="770" width="130" height="170" as="geometry"/></mxCell><mxCell id="p1_s_start" value="BẮT ĐẦU — mỗi thao tác ở&lt;br&gt;F1–F5 (đổi trạng thái case /&lt;br&gt;thiết bị, dời hạn, tạm dừng,&lt;br&gt;đánh giá, kiểm tra định kỳ)" style="whiteSpace=wrap;html=1;fillColor=#1d2b4f;strokeColor=#1d2b4f;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;ellipse;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="150" y="155" width="196" height="80" as="geometry"/></mxCell><mxCell id="p1_s_log" value="Ghi Timeline + Audit Log có&lt;br&gt;thời điểm, người làm, lý do&lt;br&gt;(BR-16) — nguồn duy nhất" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="374" y="159" width="196" height="72" as="geometry"/></mxCell><mxCell id="p1_s_calc" value="Tính lại chỉ số NGAY khi có&lt;br&gt;sự kiện + theo chu kỳ (đề&lt;br&gt;xuất 15 phút) cho chỉ số&lt;br&gt;phụ thuộc thời gian" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="604" y="159" width="186" height="72" as="geometry"/></mxCell><mxCell id="p1_dExcl" value="Case thuộc&lt;br&gt;nhóm loại trừ?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="844" y="149" width="156" height="92" as="geometry"/></mxCell><mxCell id="p1_s_excl" value="Case con đã gộp (N5), Rejected,&lt;br&gt;Cancelled, case &quot;Khảo sát thiết&lt;br&gt;bị&quot; (F5): KHÔNG tính vào thời&lt;br&gt;gian xử lý / % đúng hạn; vẫn&lt;br&gt;đếm số lượng" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="818" y="442" width="210" height="86" as="geometry"/></mxCell><mxCell id="p1_s_kpi" value="CHỈ SỐ: phản hồi đầu · thời gian xử lý · % đúng hạn theo&lt;br&gt;HẠN CÓ HIỆU LỰC và theo SLA GỐC (N16) · số lần dời hạn ·&lt;br&gt;tỷ lệ mở lại · đánh giá TB · thời gian On Hold theo lý do (N13)&lt;br&gt;· thời gian pha bên thứ 3 · KHẨN CẤP: thời gian khống chế /&lt;br&gt;khắc phục, số case bị HẠ MỨC (tính SLA theo mức mới từ lúc hạ)&lt;br&gt;· % kế hoạch định kỳ ĐÚNG LỊCH (G7) · thời gian&lt;br&gt;thao tác thực tế so với giờ công nhập (G7) · số lần Technician&lt;br&gt;từ chối + lý do (N10)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1122" y="122" width="380" height="146" as="geometry"/></mxCell><mxCell id="p1_dThr" value="Vượt ngưỡng&lt;br&gt;&quot;Cần chú ý&quot;?" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1684" y="149" width="156" height="92" as="geometry"/></mxCell><mxCell id="p1_s_alert" value="Đưa vào &quot;Cần chú ý&quot; (MGR-01,&lt;br&gt;OFF-01) + báo Officer PHỤ TRÁCH&lt;br&gt;TÒA (N11). Quá hạn: Manager đã&lt;br&gt;được báo ở F3 / F4 → không gửi&lt;br&gt;trùng lần 2" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1660" y="442" width="206" height="86" as="geometry"/></mxCell><mxCell id="p1_s_upd" value="Cập nhật dashboard&lt;br&gt;(MGR-01, ANA-01..03)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2074" y="165" width="176" height="60" as="geometry"/></mxCell><mxCell id="p1_c_p2" value="⇢ Trang 2&lt;br&gt;xem &amp;amp; phân tích" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2318" y="165" width="140" height="60" as="geometry"/></mxCell><mxCell id="p1_note_thr" value="NGƯỠNG &quot;Cần chú ý&quot; (bước ④) — R3 đã có: case quá hạn &amp;gt; 24 h, On Hold &amp;gt; 3 ngày, kế hoạch định kỳ quá hạn, thiết bị ≥ 3 lần sửa / 30 ngày.&lt;br&gt;ĐỀ XUẤT thêm: case bị dời hạn ≥ 2 lần; Technician từ chối ≥ 3 việc / tuần; (cảnh báo khẩn cấp chưa xác nhận do F4 phát, không lặp ở đây). Ngưỡng chỉnh ở ADM-07." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="2218" y="435" width="480" height="100" as="geometry"/></mxCell><mxCell id="p1_o_alert" value="Officer nhận thông báo, xử lý&lt;br&gt;ngay trong luồng gốc (giao&lt;br&gt;lại, dời lịch, lập kế hoạch)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1838" y="634" width="200" height="72" as="geometry"/></mxCell><mxCell id="p1_l_src" value="→ F3 / F4 / F2&lt;br&gt;(luồng gốc của case)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2118" y="642" width="170" height="56" as="geometry"/></mxCell><mxCell id="p1_op_def" value="OPEN S03: &quot;đúng lịch&quot; của kế hoạch định kỳ (G7) = xong TRƯỚC hạn, hay trong cửa sổ ± N ngày quanh ngày đến hạn? R3 chỉ có &quot;on-time rate&quot; ở PM-03, chưa định nghĩa." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1372" y="618" width="250" height="104" as="geometry"/></mxCell><mxCell id="p1_op_gaming" value="OPEN S02 (O09 của F3): lấy hạn dài hơn → dời hạn là &quot;đúng hạn&quot;. Đề xuất: dashboard luôn hiện CẢ HAI tỷ lệ (theo hạn có hiệu lực và theo SLA gốc) + số lần dời hạn." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="992" y="622" width="270" height="96" as="geometry"/></mxCell><mxCell id="p1_op_scope" value="OPEN S01: Officer chỉ xem chỉ số tòa mình phụ trách (vì đã bỏ hàng chờ chung, BR-19)? Manager xem tất cả tòa + so sánh giữa các tòa." style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="572" y="625" width="250" height="90" as="geometry"/></mxCell><mxCell id="p1_note_small" value="Hiệu suất Technician dựa trên &amp;lt; 5 case: hiện cảnh báo &quot;chưa đủ tin cậy&quot; (ANA-02, R3 3.11.1)." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1132" y="827" width="360" height="56" as="geometry"/></mxCell><mxCell id="p1_c9" value="①" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="362" y="147" width="26" height="26" as="geometry"/></mxCell><mxCell id="p1_c10" value="②" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="592" y="147" width="26" height="26" as="geometry"/></mxCell><mxCell id="p1_c11" value="N5" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="431" width="26" height="18" as="geometry"/></mxCell><mxCell id="p1_c12" value="③" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="110" width="26" height="26" as="geometry"/></mxCell><mxCell id="p1_c13" value="G7" style="rounded=1;arcSize=40;html=1;fillColor=#EDE4FA;strokeColor=#7B4FC9;fontColor=#4B2A8A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1474" y="111" width="26" height="18" as="geometry"/></mxCell><mxCell id="p1_c14" value="N16" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1440" y="111" width="31" height="18" as="geometry"/></mxCell><mxCell id="p1_c15" value="N10" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1406" y="111" width="31" height="18" as="geometry"/></mxCell><mxCell id="p1_c16" value="④" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1704" y="152" width="26" height="26" as="geometry"/></mxCell><mxCell id="p1_c17" value="N11" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1832" y="431" width=