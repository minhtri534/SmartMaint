<diagram name="F6-2 Xem, phân tích &amp; hành động" id="p2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="2417" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_c1" value="F6 · TRANG 2/2 — Manager xem, phân tích và hành động" style="text;html=1;fontStyle=1;fontSize=20;align=left;verticalAlign=middle;fontColor=#1d2b4f;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2377" height="30" as="geometry"/></mxCell><mxCell id="p2_c2" value="Manager CHỈ XEM trong hệ thống (BR-12): không giao, không duyệt, không chỉnh cấu hình. Mọi chỉ đạo diễn ra NGOÀI hệ thống; thay đổi thật do Officer (case, kế hoạch) hoặc Admin (cấu hình) thực hiện. Admin không xem case (BR-11).&lt;br&gt;Chú thích: xanh lá = ĐÃ CÓ trong Report 3 · xanh dương = MỚI (đề xuất / thầy chốt) · cam = OPEN · đỏ = MÂU THUẪN · xám viền đứt = việc NGOÀI hệ thống · ①–⑨ = đường chính · ⏱ = thời gian · ⇢ = sang trang · → Fx = sang luồng khác · thẻ Gx = góp ý hội đồng R1 · thẻ Nx = ý trong note thầy 12/10." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="2377" height="48" as="geometry"/></mxCell><mxCell id="p2_c3" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="2397" height="420" as="geometry"/></mxCell><mxCell id="p2_c4" value="Facility&lt;br&gt;Manager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="100" width="130" height="420" as="geometry"/></mxCell><mxCell id="p2_c5" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="520" width="2397" height="190" as="geometry"/></mxCell><mxCell id="p2_c6" value="Ngoài hệ thống&lt;br&gt;(họp, điện&lt;br&gt;thoại, văn bản)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="520" width="130" height="190" as="geometry"/></mxCell><mxCell id="p2_c7" value="" style="rounded=0;html=1;fillColor=#F7F9FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="710" width="2397" height="260" as="geometry"/></mxCell><mxCell id="p2_c8" value="Officer&lt;br&gt;phụ trách tòa" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="710" width="130" height="260" as="geometry"/></mxCell><mxCell id="p2_c9" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="10" y="970" width="2397" height="180" as="geometry"/></mxCell><mxCell id="p2_c10" value="Admin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3E9F2;strokeColor=#B8C0CC;fontStyle=1;fontSize=13;fontColor=#33415c;" vertex="1" parent="1"><mxGeometry x="10" y="970" width="130" height="180" as="geometry"/></mxCell><mxCell id="p2_m_in" value="⇢ từ Trang 1" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=offPageConnector;size=0.25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="182" y="167" width="130" height="56" as="geometry"/></mxCell><mxCell id="p2_m_start" value="BẮT ĐẦU (cách 2)&lt;br&gt;Manager mở MGR-01&lt;br&gt;(hằng ngày / họp tuần)" style="whiteSpace=wrap;html=1;fillColor=#1d2b4f;strokeColor=#1d2b4f;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;ellipse;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="162" y="417" width="170" height="66" as="geometry"/></mxCell><mxCell id="p2_m_dash" value="Xem MGR-01: chỉ số so với&lt;br&gt;tuần trước + danh sách&lt;br&gt;&quot;Cần chú ý&quot;" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="390" y="159" width="186" height="72" as="geometry"/></mxCell><mxCell id="p2_m_filter" value="Lọc ANA-01..03: tòa, thời&lt;br&gt;gian, loại dịch vụ, mức khẩn&lt;br&gt;cấp, Technician" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="612" y="159" width="190" height="72" as="geometry"/></mxCell><mxCell id="p2_dAbn" value="Có bất&lt;br&gt;thường?" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="862" y="153" width="140" height="84" as="geometry"/></mxCell><mxCell id="p2_m_export" value="Xuất báo cáo (ANA-04,&lt;br&gt;PDF / Excel) cho họp&lt;br&gt;ban quản lý tòa nhà" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="842" y="415" width="180" height="70" as="geometry"/></mxCell><mxCell id="p2_e_ok" value="KẾT THÚC" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=doubleEllipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1098" y="427" width="120" height="46" as="geometry"/></mxCell><mxCell id="p2_m_drill" value="Xem sâu: danh sách case (OFF-03,&lt;br&gt;chỉ xem) · hiệu suất Technician&lt;br&gt;(ANA-02, số lần từ chối + lý do,&lt;br&gt;N10) · thiết bị hay hỏng (ANA-03)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1058" y="152" width="220" height="86" as="geometry"/></mxCell><mxCell id="p2_dCause" value="Nguyên nhân&lt;br&gt;thuộc nhóm nào?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1456" y="147" width="164" height="96" as="geometry"/></mxCell><mxCell id="p2_x_talk" value="Manager trao đổi / chỉ đạo&lt;br&gt;Officer phụ trách tòa&lt;br&gt;(họp, điện thoại)" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;dashed=1;dashPattern=8 4;fillColor=#F4F4F5;strokeColor=#71717A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1442" y="582" width="190" height="66" as="geometry"/></mxCell><mxCell id="p2_dAct" value="Officer xử&lt;br&gt;lý gì?" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rhombus;" vertex="1" parent="1"><mxGeometry x="1468" y="758" width="140" height="84" as="geometry"/></mxCell><mxCell id="p2_l_F2" value="→ F3 / F4: giao lại,&lt;br&gt;dời lịch, ưu tiên lại" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1724" y="772" width="176" height="56" as="geometry"/></mxCell><mxCell id="p2_l_F4" value="→ F2: lập kế hoạch&lt;br&gt;định kỳ (PM-02)" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1728" y="877" width="170" height="56" as="geometry"/></mxCell><mxCell id="p2_l_F5" value="→ F5: xem xét sửa&lt;br&gt;hay thay thiết bị" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1268" y="877" width="170" height="56" as="geometry"/></mxCell><mxCell id="p2_e_none" value="KẾT THÚC" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=doubleEllipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1462" y="883" width="110" height="44" as="geometry"/></mxCell><mxCell id="p2_x_req" value="Manager gửi đề nghị Admin&lt;br&gt;đổi quy tắc / danh mục&lt;br&gt;(văn bản)" style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;dashed=1;dashPattern=8 4;fillColor=#F4F4F5;strokeColor=#71717A;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1890" y="582" width="196" height="66" as="geometry"/></mxCell><mxCell id="p2_a_cfg" value="Admin chỉnh ADM-07 (SLA,&lt;br&gt;ngưỡng) hoặc ADM-06 (danh&lt;br&gt;mục dịch vụ); ghi Audit Log,&lt;br&gt;áp dụng cho case MỚI" style="whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#2E8B57;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1888" y="1017" width="200" height="86" as="geometry"/></mxCell><mxCell id="p2_l_F1" value="→ F1 Trang 1&lt;br&gt;(danh mục dịch vụ)" style="whiteSpace=wrap;html=1;fillColor=#DCEAFB;strokeColor=#2F6DB5;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=1;arcSize=20;dashed=1;dashPattern=2 3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2152" y="1032" width="160" height="56" as="geometry"/></mxCell><mxCell id="p2_op_esc" value="OPEN S04 (N14, O10 của F3): Manager chỉ xem → có cần &quot;ghi chú chỉ đạo&quot; trên case (chỉ thêm bình luận, không đổi trạng thái) để lưu vết không? Hay giữ chỉ đạo hoàn toàn ngoài hệ thống?" style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="1168" y="285" width="270" height="110" as="geometry"/></mxCell><mxCell id="p2_op_req" value="OPEN S05: R3 không có kênh Manager → Admin. Đề nghị đổi SLA / ngưỡng nên có biểu mẫu trong hệ thống hay làm ngoài?" style="whiteSpace=wrap;html=1;fillColor=#FFE3BF;strokeColor=#E8830C;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;rounded=0;" vertex="1" parent="1"><mxGeometry x="2158" y="570" width="230" height="90" as="geometry"/></mxCell><mxCell id="p2_note_off" value="Officer cũng xem ANA-01 rút gọn (không có xếp hạng Technician, không có đánh giá) và xuất được Case summary / Asset failure / Preventive compliance (R3 3.11.2)." style="whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#666666;strokeWidth=2;fontSize=11;fontColor=#1b1b1b;spacing=4;shape=note;size=14;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="282" y="764" width="440" height="72" as="geometry"/></mxCell><mxCell id="p2_c11" value="⑤" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="378" y="147" width="26" height="26" as="geometry"/></mxCell><mxCell id="p2_c12" value="⑥" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="147" width="26" height="26" as="geometry"/></mxCell><mxCell id="p2_c13" value="⑦" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="878" y="154" width="26" height="26" as="geometry"/></mxCell><mxCell id="p2_c14" value="⑧" style="ellipse;html=1;fillColor=#1d2b4f;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1046" y="140" width="26" height="26" as="geometry"/></mxCell><mxCell id="p2_c15" value="N10" style="rounded=1;arcSize=40;html=1;fillColor=#D5F2EE;strokeColor=#0F766E;fontColor=#0B4F4A;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1244" y="141" width="31" height="18" as="