# SmartMaint web — copy to frontend/.env.local (git-ignored). Only VITE_* variables reach the browser.
# Never put secrets here: everything in a VITE_ variable is public in the built JS.

# Base URL of the .NET API.
# Local dev: leave empty -> requests go to /api on the Vite dev server, which proxies to http://localhost:5080.
# Vercel:    https://<your-railway-service>.up.railway.app
VITE_API_BASE_URL=
