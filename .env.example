# ============================================================================
# SmartMaint — environment variables (backend + docker compose)
# Local:      copy this file to `.env` in the repo root and adjust. `.env` is git-ignored.
# Railway:    set the same keys in the service's Variables tab (real values, never commit them).
# Frontend variables live in frontend/.env.example (Vite needs its own file).
# Double underscore "__" = nested config section in .NET (Jwt__SigningKey -> Jwt:SigningKey).
# ============================================================================

# ---- Local Postgres (docker-compose.yml) ----
POSTGRES_DB=smartmaint
POSTGRES_USER=smartmaint
POSTGRES_PASSWORD=smartmaint
POSTGRES_PORT=5432

# ---- Backend: database ----
# Local:  the docker Postgres above.
# Supabase: dashboard > Connect > Session pooler (port 5432), written in key=value form, with "SSL Mode=Require".
#         If port 5432 times out on your network, use the Transaction pooler (port 6543) and add
#         ";No Reset On Close=true" (16/11: that is what works from the Leader's machine). Host is aws-0-... or aws-1-...
#         as shown in Connect; the wrong one answers "tenant/user ... not found".
ConnectionStrings__Default=Host=localhost;Port=5432;Database=smartmaint;Username=smartmaint;Password=smartmaint

# ---- Backend: JWT ----
# Any random string >= 32 chars. Generate one: `openssl rand -base64 48`. Use a different value per environment.
Jwt__SigningKey=change-me-local-dev-signing-key-at-least-32-chars
Jwt__AccessTokenMinutes=480

# ---- Backend: CORS (web origins allowed to call the API) ----
# Local dev uses the Vite proxy, so this only matters for deployed environments.
Cors__AllowedOrigins__0=http://localhost:5173

# ---- Backend: database bootstrap ----
# true only for local dev (launchSettings.json already sets it). Never true on Railway.
# Database__MigrateAndSeedOnStartup=true

# ---- Backend: file storage (case photos) ----
# Supabase > Project Settings > API: project URL + service_role key (server only, never in the web app).
# Create a PRIVATE bucket with this name in Supabase > Storage. Leave Url empty to store files in
# backend/src/SmartMaint.Api/uploads/ instead (local dev only, git-ignored).
Supabase__Url=
Supabase__ServiceRoleKey=
Supabase__StorageBucket=smartmaint

# ---- Backend: AI suggestions (Replicate) ----
# replicate.com > Account > API tokens. Server only, never in the web app, never committed.
# Leave empty to run without AI: the screens still work (the web falls back to keyword rules).
Replicate__ApiToken=
# Model "owner/name" (default meta/meta-llama-3-70b-instruct; openai/gpt-5-nano is cheaper but Replicate answers 500
# for OpenAI models on our account, 16/11) and the time limit for one question, in seconds (default 25).
# Replicate__Model=meta/meta-llama-3-70b-instruct
# Replicate__TimeoutSeconds=25

# ---- Reserved for later modules (not used yet) ----
# Smtp__Host=
# Smtp__Port=
# Smtp__Username=
# Smtp__Password=

# ---- Backend: background jobs ----
# Minutes between SLA reminder runs (0 = off). Default 5 in appsettings.json.
# Jobs__SlaReminderMinutes=5
# Minutes between preventive maintenance runs: makes the work orders due within each plan's lead time (0 = off).
# Default 60 in appsettings.json.
# Jobs__MaintenanceGeneratorMinutes=60
# Minutes between emergency watch runs: backup staff after 10 min unacknowledged, managers after 30, technician not accepting after 10 (0 = off).
# Default 1 in appsettings.json.
# Jobs__EmergencyWatchMinutes=1
