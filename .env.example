# ============================================================================
# SmartMaint — environment variables (backend + docker compose)
# Local:      copy this file to `.env` in the repo root and adjust. `.env` is git-ignored.
# Railway:    set the same keys in the service's Variables tab (real values, never commit them).
# Frontend variables live in frontend/.env.example (Vite needs its own file).
# Double underscore "__" = nested config section in .NET (Jwt__SigningKey -> Jwt:SigningKey).
# ============================================================================

# ---- Local Postgres (docker-compose.yml) ----
POSTGRES_DB=smartmaint
POSTGRES_USER=smartmaint
POSTGRES_PASSWORD=smartmaint
POSTGRES_PORT=5432

# ---- Backend: database ----
# Local:  the docker Postgres above.
# Deploy: Supabase > Project Settings > Database > Connection string (Session pooler, port 5432),
#         written in key=value form, with "SSL Mode=Require".
ConnectionStrings__Default=Host=localhost;Port=5432;Database=smartmaint;Username=smartmaint;Password=smartmaint

# ---- Backend: JWT ----
# Any random string >= 32 chars. Generate one: `openssl rand -base64 48`. Use a different value per environment.
Jwt__SigningKey=change-me-local-dev-signing-key-at-least-32-chars
Jwt__AccessTokenMinutes=480

# ---- Backend: CORS (web origins allowed to call the API) ----
# Local dev uses the Vite proxy, so this only matters for deployed environments.
Cors__AllowedOrigins__0=http://localhost:5173

# ---- Backend: database bootstrap ----
# true only for local dev (launchSettings.json already sets it). Never true on Railway.
# Database__MigrateAndSeedOnStartup=true

# ---- Reserved for later modules (not used yet) ----
# Supabase__Url=
# Supabase__ServiceRoleKey=
# Supabase__StorageBucket=
# Replicate__ApiToken=
# Smtp__Host=
# Smtp__Port=
# Smtp__Username=
# Smtp__Password=
